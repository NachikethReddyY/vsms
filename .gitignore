# Node modules
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# Runtime-only consent signature evidence
backend/secure-data/

# Database exports can contain credentials, password hashes, bearer tokens, and PHI.
backend/backups/*.sql
backend/backups/*.dump
backend/backups/*.backup
backend/backups/*.tar
*.pgdump

# Local generated plan viewer
.local-plan-preview/

# Generated test artifacts
coverage/
**/coverage/
playwright-report/
test-results/

# Local semantic repository indexes
.repo-index/

# Local TLS certificates and private keys (generate these per developer machine)
react-user-dashboard/certs/*.pem
backend/certs/*.pem

# Bruno reports can contain short-lived bearer tokens and response headers
api-testing/results/

# Local security-scan artifacts
gitleaks-report.json
semgrep-report.json

# Locally generated submission archive
.submission/
