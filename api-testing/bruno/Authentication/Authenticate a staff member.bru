meta {
  name: Authenticate a staff member
  type: http
  seq: 1
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "identifier": "{{managerUsername}}",
    "password": "{{managerPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("token", res.getBody().accessToken);
    bru.setVar("csrfToken", res.getBody().csrfToken);
  }
}

tests {
  test("manager login succeeds without exposing refresh token", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accessToken).to.be.a("string");
    expect(res.getBody().refreshToken).to.equal(undefined);
    expect(res.getBody().user.username).to.equal("manager");
    expect(res.getBody().user.systemRole).to.equal("EVENT_MANAGER");
  });
}

example {
  name: 200 Response
  description: Login succeeded; refresh and CSRF cookies are also set

  request: {
    url: {{baseUrl}}/auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "accessToken": "",
          "csrfToken": "",
          "user": {
            "userId": "",
            "email": "",
            "systemRole": "ADMIN",
            "status": "ACTIVE",
            "createdAt": ""
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication is absent, invalid, expired, revoked, or reused

  request: {
    url: {{baseUrl}}/auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "code": "",
          "requestId": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

