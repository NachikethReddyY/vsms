meta {
  name: Check Cognito managed login bootstrap
  type: http
  seq: 1
  tags: [
    Authentication
  ]
}

get {
  url: {{baseUrl}}/auth/config-status
  body: none
  auth: none
}

docs {
  This collection uses the real Cognito managed login flow. There is no API password-login or POST /auth/login/token endpoint.

  To acquire runnable browser-session cookies locally:
  1. Open {{baseUrl}}/auth/authorize?returnTo=/dashboard in a browser.
  2. Complete Cognito hosted UI sign-in and allow /auth/callback to set HttpOnly cookies.
  3. Copy the resulting browser cookies into Bruno environment variables for API-only examples:
     - refreshCookie = value of vsms_refresh
     - username = value of vsms_username
     - accessCookie = value of vsms_access, only needed for global logout
     - csrfToken = current CSRF token value expected by the API

  Requests such as refresh/logout intentionally send Cookie plus X-CSRF-Token/Origin headers to model the browser session. They do not expect tokens in JSON responses.
}

tests {
  test("Cognito managed login configuration status is readable", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("configured");
  });
}

example {
  name: 200 Response
  description: Authentication configuration status; use /auth/authorize in a browser when configured

  request: {
    url: {{baseUrl}}/auth/config-status
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "configured": true,
          "authorizeUrl": "/auth/authorize"
        }
      '''
    }
  }
}
