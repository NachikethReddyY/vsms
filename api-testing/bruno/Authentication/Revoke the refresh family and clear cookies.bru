meta {
  name: Revoke the refresh family and clear cookies
  type: http
  seq: 3
  tags: [
    Authentication
    session
  ]
}

headers {
  Cookie: vsms_csrf={{csrfToken}}
  Origin: {{origin}}
  Sec-Fetch-Site: same-origin
  X-CSRF-Token: {{csrfToken}}
}

tests {
  test("logout clears the local browser session", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Logged out successfully");
    expect(res.getBody().logoutUrl).to.be.a("string");
  });
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: none
}

example {
  name: 200 Response
  description: Local browser cookies cleared; Set-Cookie expires auth and CSRF cookies

  request: {
    url: {{baseUrl}}/auth/logout
    method: POST
    mode: none
    headers: {
      Cookie: vsms_csrf={{csrfToken}}
      X-CSRF-Token: {{csrfToken}}
      Origin: {{origin}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
      Set-Cookie: vsms_access=; Max-Age=0, vsms_refresh=; Max-Age=0, vsms_username=; Max-Age=0, vsms_csrf=; Max-Age=0
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "message": "Logged out successfully",
          "logoutUrl": "https://cognito.example.com/logout"
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Request origin, CSRF token, or permission is invalid

  request: {
    url: {{baseUrl}}/auth/logout
    method: POST
    mode: none
    headers: {
      Cookie: vsms_csrf={{csrfToken}}
      X-CSRF-Token: {{csrfToken}}
      Origin: {{origin}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "code": "",
          "requestId": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}
