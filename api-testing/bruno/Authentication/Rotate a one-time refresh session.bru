    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "code": "",
          "requestId": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 429 Response
  description: Rate limit exceeded

  request: {
    url: {{baseUrl}}/auth/refresh
    method: POST
    mode: none
    headers: {
      Cookie: vsms_refresh={{refreshCookie}}; vsms_username={{username}}; vsms_csrf={{csrfToken}}
      X-CSRF-Token: {{csrfToken}}
      Origin: {{origin}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "code": "",
          "requestId": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}
