meta {
  name: Refresh Cognito-backed browser session
  type: http
  seq: 2
  tags: [
    Authentication
    session
  ]
}

headers {
  Cookie: vsms_refresh={{refreshCookie}}; vsms_username={{username}}; vsms_csrf={{csrfToken}}
  Origin: {{origin}}
  Sec-Fetch-Site: same-origin
  X-CSRF-Token: {{csrfToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("sessionExpiresIn", res.getBody().sessionExpiresIn);
  }
}

tests {
  test("refresh exchanges the Cognito refresh cookie without exposing browser tokens", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().expiresIn).to.be.a("number");
    expect(res.getBody().sessionExpiresIn).to.be.a("number");
    expect(res.getBody().user).to.be.an("object");
    expect(res.getBody().accessToken).to.equal(undefined);
    expect(res.getBody().csrfToken).to.equal(undefined);
    expect(res.getBody().refreshToken).to.equal(undefined);
  });
}

post {
  url: {{baseUrl}}/auth/refresh
  body: none
  auth: none
}

example {
  name: 200 Response
  description: Cognito refresh cookie exchanged and replacement auth cookies issued

  request: {
    url: {{baseUrl}}/auth/refresh
    method: POST
    mode: none
    headers: {
      Cookie: vsms_refresh={{refreshCookie}}; vsms_username={{username}}; vsms_csrf={{csrfToken}}
      X-CSRF-Token: {{csrfToken}}
      Origin: {{origin}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "expiresIn": 900,
          "sessionExpiresIn": 3600,
          "user": {
            "userId": "",
            "email": "",
            "systemRole": "ADMIN",
            "status": "ACTIVE",
            "createdAt": ""
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Cognito refresh cookie is absent, invalid, expired, revoked, or rejected

  request: {
    url: {{baseUrl}}/auth/refresh
    method: POST
    mode: none
    headers: {
      Cookie: vsms_refresh={{refreshCookie}}; vsms_username={{username}}; vsms_csrf={{csrfToken}}
      X-CSRF-Token: {{csrfToken}}
      Origin: {{origin}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "code": "",
          "requestId": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

