meta {
  name: List events visible to the current staff member
  type: http
  seq: 1
  tags: [
    Events
  ]
}

tests {
  test("visible event list is returned", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().events).to.be.an("array");
  });
}

get {
  url: {{baseUrl}}/api/events
  body: none
  auth: inherit
}

params:query {
  limit: 25
  ~cursor:
  ~status: DRAFT
  ~status: PUBLISHED
  ~status: IN_PROGRESS
  ~status: COMPLETED
  ~status: CANCELLED
  ~search:
}

example {
  name: 200 Response
  description: Authorized, cursor-paginated events

  request: {
    url: {{baseUrl}}/api/events
    method: GET
    mode: none
    params:query: {
      ~cursor:
      limit: 25
      ~status: DRAFT
      ~status: PUBLISHED
      ~status: IN_PROGRESS
      ~status: COMPLETED
      ~status: CANCELLED
      ~search:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "events": [],
          "nextCursor": ""
        }
      '''
    }
  }
}

