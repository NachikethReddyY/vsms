meta {
  name: Move a draft event to published
  type: http
  seq: 5
  tags: [
    Events
  ]
}

post {
  url: {{baseUrl}}/api/events/:eventId/publish
  body: json
  auth: inherit
}

params:path {
  eventId: {{eventId}}
}

body:json {
  {
    "version": {{eventVersion}}
  }
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("eventVersion", res.getBody().version);
}

tests {
  test("draft publishes", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("PUBLISHED");
  });
}

example {
  name: 200 Response
  description: Event transitioned and audited

  request: {
    url: {{baseUrl}}/api/events/:eventId/publish
    method: POST
    mode: json
    params:path: {
      eventId:
    }

    body:json: {
      {
        "version": 0
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''

      '''
    }
  }
}

