meta {
  name: Update allowed fields using optimistic concurrency
  type: http
  seq: 4
  tags: [
    Events
  ]
}

patch {
  url: {{baseUrl}}/api/events/:eventId
  body: json
  auth: inherit
}

params:path {
  eventId: {{eventId}}
}

body:json {
  {
    "version": {{eventVersion}},
    "capacity": 140
  }
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("eventVersion", res.getBody().version);
}

tests {
  test("versioned update succeeds", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().capacity).to.equal(140);
  });
}

example {
  name: 200 Response
  description: Event updated and audited

  request: {
    url: {{baseUrl}}/api/events/:eventId
    method: PATCH
    mode: json
    params:path: {
      eventId:
    }

    body:json: {
      {
        "version": 0,
        "name": "",
        "description": "",
        "venue": "",
        "timezone": "",
        "startsAt": "",
        "endsAt": "",
        "capacity": 0,
        "shifts": [
          {
            "shiftId": "",
            "name": "",
            "startsAt": "",
            "endsAt": "",
            "requiredStaff": 0
          }
        ]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''

      '''
    }
  }
}

