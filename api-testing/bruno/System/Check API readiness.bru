meta {
  name: Check API readiness
  type: http
  seq: 1
  tags: [
    System
  ]
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: inherit
}

tests {
  test("health is ready", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ok");
  });
}

example {
  name: 200 Response
  description: API is ready

  request: {
    url: {{baseUrl}}/health
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "status": "ok"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Health endpoint is unavailable

  request: {
    url: {{baseUrl}}/health
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "code": "",
          "requestId": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 500 Response
  description: Service is not ready

  request: {
    url: {{baseUrl}}/health
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "code": "",
          "requestId": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}
