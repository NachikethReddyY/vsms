DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vsms
HOST=127.0.0.1
PORT=5050
NODE_ENV=development

# Use a stable secret outside local development. Production requires this value.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=vsms-api
JWT_AUDIENCE=vsms-dashboard
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Public account creation is intentionally disabled unless an administrator opts in.
PUBLIC_SIGNUP_ENABLED=false
VSMS_DEMO_PASSWORD=Demo-Only-Change-Me-2026!

CORS_ORIGINS=https://localhost:5173,https://127.0.0.1:5173
# Production requires an HTTPS, non-local bare origin. Local development defaults
# to https://localhost:5173 when this is omitted.
PUBLIC_APP_ORIGIN=https://localhost:5173
TRUST_PROXY=false
TLS_KEY_PATH=../react-user-dashboard/certs/localhost-key.pem
TLS_CERT_PATH=../react-user-dashboard/certs/localhost.pem
LOG_LEVEL=info

# Optional. Register at https://www.onemap.gov.sg/apidocs/register to enable
# token-authenticated Singapore address search. Tokens are cached and renewed
# automatically before OneMap's 72-hour expiry. Never expose these in the UI.
# Event creation still supports manual locations.
ONEMAP_BASE_URL=https://www.onemap.gov.sg
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=

# Amazon Cognito staff authentication
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_example
# Required by default. Use local-only solely for explicit local development
# without Cognito; production rejects that mode.
COGNITO_STAFF_SYNC_MODE=required
COGNITO_APP_CLIENT_ID=exampleclientid
# Leave empty when the selected Cognito app client has no secret.
COGNITO_APP_CLIENT_SECRET=
COGNITO_DOMAIN=https://vsms-staff-development-123456789012.auth.ap-southeast-1.amazoncognito.com
COGNITO_REDIRECT_URI=https://localhost:5173/auth/callback
COGNITO_LOGOUT_URI=https://localhost:5173

# Secure session and participant-registration controls
REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
REQUEST_BODY_LIMIT=256kb
SIGNATURE_STORAGE_DIR=
PRISMA_LOG_QUERIES=false

# Optional local seed administrator.
SEED_STAFF_EMAIL=seed.admin@cryptix.local
SEED_STAFF_NAME=Seed Administrator
SEED_STAFF_EMPLOYEE_NUMBER=SEED-ADMIN-001
