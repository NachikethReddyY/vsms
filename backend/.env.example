DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vsms
HOST=127.0.0.1
PORT=5050
NODE_ENV=development
LOCAL_HTTPS=true

# Use a stable secret outside local development. Production requires this value.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Legacy JWT_SECRET is no longer used by the backend; a random value is fine.
JWT_SECRET=replace-with-an-unused-random-value
JWT_ISSUER=vsms-api
JWT_AUDIENCE=vsms-dashboard
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Public account creation is intentionally disabled unless an administrator opts in.
PUBLIC_SIGNUP_ENABLED=false
VSMS_DEMO_PASSWORD=Demo-Only-Change-Me-2026!

CORS_ORIGINS=https://localhost:5173,https://127.0.0.1:5173
# Production requires an HTTPS, non-local bare origin. Local development defaults
# to https://localhost:5173 when this is omitted.
PUBLIC_APP_ORIGIN=https://localhost:5173
TRUST_PROXY=false
TLS_KEY_PATH=../react-user-dashboard/certs/localhost-key.pem
TLS_CERT_PATH=../react-user-dashboard/certs/localhost.pem
LOG_LEVEL=info

# Optional. Register at https://www.onemap.gov.sg/apidocs/register to enable
# token-authenticated Singapore address search. Tokens are cached and renewed
# automatically before OneMap's 72-hour expiry. Never expose these in the UI.
# Event creation still supports manual locations.
ONEMAP_BASE_URL=https://www.onemap.gov.sg
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=

# Amazon Cognito staff authentication
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_example
# Required by default. Use local-only solely for explicit local development
# without Cognito; production rejects that mode.
COGNITO_STAFF_SYNC_MODE=required
COGNITO_APP_CLIENT_ID=exampleclientid
# Leave empty when the selected Cognito app client has no secret.
COGNITO_APP_CLIENT_SECRET=
COGNITO_DOMAIN=https://vsms-staff-development-123456789012.auth.ap-southeast-1.amazoncognito.com
COGNITO_REDIRECT_URI=https://localhost:5173/auth/callback
COGNITO_LOGOUT_URI=https://localhost:5173

# Secure session and participant-registration controls
# Requests allowed to /api/v1/auth per 15-minute window (default 5).
AUTH_RATE_LIMIT=5
# Stable 256-bit HMAC key used only for equality lookup of encrypted NRIC values.
# Production requires a dedicated value; do not reuse the AES or JWT key.
PARTICIPANT_LOOKUP_HMAC_KEY=replace-with-64-hex-characters
REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
REQUEST_BODY_LIMIT=256kb
SIGNATURE_STORAGE_DIR=
PRISMA_LOG_QUERIES=false

# Redis-backed rate limiting. All limiters share one connection and fall back
# to in-process memory when Redis is unreachable (fail-open).
# RATE_LIMIT_STORE: auto | memory | redis  (auto uses Redis when REDIS_URL is set)
REDIS_URL=redis://localhost:6379
RATE_LIMIT_STORE=auto

# Encrypted referral delivery. SES_SNS_TOPIC_ARNS is a comma-separated allowlist
# used before any signed provider callback can change delivery state.
AWS_REGION=us-east-1
SES_FROM_EMAIL=
SES_SNS_TOPIC_ARNS=

# Aggregate report worker and expiring local artifact storage.
REPORT_STORAGE_DIR=
REPORT_ARTIFACT_EXPIRY_HOURS=168
REPORT_WORKER_POLL_MS=5000
ANALYTICS_SMALL_CELL_THRESHOLD=5

# Non-clinical lifecycle email through Google Workspace OAuth2. Leave disabled
# for local development and tests. Production enablement fails closed unless
# all OAuth2 values are present and the sender is explicitly allowlisted.
LIFECYCLE_EMAIL_ENABLED=false
LIFECYCLE_EMAIL_FROM=
LIFECYCLE_EMAIL_ALLOWED_SENDERS=
GOOGLE_WORKSPACE_USER=
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN=
LIFECYCLE_EMAIL_CONNECTION_TIMEOUT_MS=10000
LIFECYCLE_EMAIL_SOCKET_TIMEOUT_MS=30000
LIFECYCLE_EMAIL_WORKER_POLL_MS=5000

# Optional local synthetic seed administrator.
SEED_STAFF_EMAIL=synthetic.admin@example.test
SEED_STAFF_NAME=Synthetic Administrator
SEED_STAFF_EMPLOYEE_NUMBER=SYNTH-ADMIN-001
