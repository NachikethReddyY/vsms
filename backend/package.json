{
  "name": "backend",
  "version": "1.0.0",
  "description": "Visual Screening Management System Backend API",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "dev:tailscale": "node --env-file=.env --env-file=.env.tailscale server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "qr:reissue-active": "node scripts/reissue-active-qr-passes.js",
    "nric:backfill": "node scripts/backfill-participant-nric.js",
    "routes:backfill-checked-in": "node scripts/backfill-checked-in-registration-routes.js",
    "seed": "node prisma/seed.js",
    "db:reset": "pnpm db:test:prepare",
    "db:test:prepare": "node scripts/prepare-test-database.js",
    "db:setup": "pnpm prisma:generate && pnpm prisma:migrate && pnpm prisma:seed",
    "acceptance:reset": "node scripts/reset-acceptance-demo.js",
    "acceptance:check": "node scripts/live-acceptance.js check",
    "acceptance:prepare": "node scripts/live-acceptance.js prepare",
    "acceptance:validate": "node scripts/live-acceptance.js validate",
    "artwork:migrate-s3": "node scripts/migrate-event-artwork-to-s3.js",
    "test": "node --test --test-force-exit \"tests/unit/*.test.js\" \"tests/security/*.test.js\"",
    "test:watch": "node --test --watch \"tests/unit/*.test.js\" \"tests/security/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.js\" \"tests/security/*.test.js\" \"tests/.vsms/*.test.js\"",
    "test:integration": "node scripts/prepare-test-database.js --run-tests",
    "openapi:lint": "redocly lint docs/openapi.yaml",
    "contracts:generate": "openapi-typescript docs/openapi.yaml -o ../react-user-dashboard/src/generated/api.ts",
    "contracts:check": "node scripts/check-contract.js",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "provision-staff": "node prisma/provisionStaff.js",
    "dev:preset": "node scripts/dev-preset.js",
    "worker:reports": "node scripts/report-worker.js",
    "worker:lifecycle-email": "node scripts/lifecycle-email-worker.js",
    "worker:domain-event": "node scripts/domain-event-worker.js",
    "perf:check": "node scripts/performance-runner.js --check --config performance/isolated-500.json",
    "perf:prepare": "node scripts/prepare-performance-fixture.js",
    "perf:token": "node scripts/performance-test-token.js",
    "perf:run": "node scripts/performance-runner.js --config performance/isolated-500.json",
    "backup:postgres": "sh scripts/backup-postgres.sh",
    "restore:postgres:test": "sh scripts/restore-postgres-test.sh",
    "deploy": "pnpm install && pnpm db:setup && pnpm start",
    "deploy:prod": "pnpm install --prod && pnpm prisma:generate && pnpm prisma:migrate && pnpm start",
    "ci": "pnpm prisma:validate && pnpm prisma:generate && pnpm test && pnpm openapi:lint"
  },
  "keywords": [
    "express",
    "nodejs",
    "prisma",
    "postgresql",
    "vsms"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1101.0",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/client-sesv2": "^3.1102.0",
    "@aws-sdk/client-sns": "^3.1102.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@redocly/cli": "^2.40.0",
    "brace-expansion": "^2.1.4",
    "expect": "^30.4.1",
    "js-yaml": "^4.3.1",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2"
  }
}
