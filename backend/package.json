{
  "name": "backend",
  "version": "1.0.0",
  "description": "Visual Screening Management System Backend API",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "dev:tailscale": "node --env-file=.env --env-file=.env.tailscale server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "pnpm prisma:generate && pnpm prisma:migrate && pnpm prisma:seed",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/security/*.test.js\"",
    "test:watch": "node --test --watch \"tests/unit/*.test.js\" \"tests/security/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.js\" \"tests/security/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\" tests/security/rateLimit.test.js tests/security/rbac.test.js",
    "openapi:lint": "redocly lint docs/openapi.yaml",
    "contracts:generate": "openapi-typescript docs/openapi.yaml -o ../react-user-dashboard/src/generated/api.ts",
    "contracts:check": "node scripts/check-contract.js",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "provision-staff": "node prisma/provisionStaff.js",
    "dev:preset": "node scripts/dev-preset.js",
    "deploy": "pnpm install && pnpm db:setup && pnpm start",
    "deploy:prod": "pnpm install --prod && pnpm db:setup && pnpm start",
    "ci": "pnpm prisma:validate && pnpm prisma:generate && pnpm test && pnpm openapi:lint"
  },
  "keywords": [
    "express",
    "nodejs",
    "prisma",
    "postgresql",
    "vsms"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1101.0",
    "@aws-sdk/client-sesv2": "^3.1102.0",
    "@aws-sdk/client-sns": "^3.1102.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "^2.40.0",
    "expect": "^30.4.1",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2"
  }
}