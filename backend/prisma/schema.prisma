// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SystemRole {
  ADMIN
  EVENT_MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
  INACTIVE
  SUSPENDED
}

enum EventAuditAction {
  CREATED
  UPDATED
  PUBLISHED
  STARTED
  COMPLETED
  CANCELLED
  DELETED
}

enum AccountApprovalState {
  PENDING
  APPROVED
  REJECTED
}

enum AccountApprovalDecisionType {
  APPROVED
  REJECTED
}

enum AccountAccessState {
  ENABLED
  SUSPENDED
  DISABLED
}

enum ProfessionalCategory {
  STAFF
  DOCTOR
}

enum AccountProviderOperationType {
  SYNC_ACCESS
  GLOBAL_SIGN_OUT
  DISABLE_AND_SIGN_OUT
}

enum AccountProviderOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  ESCALATED
  RESOLVED
}

enum DomainEventStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
  DEAD_LETTER
}

enum EventMembershipStatus {
  ACTIVE
  REMOVED
}

enum EventRole {
  EVENT_MANAGER
  REGISTRATION
  SCREENER
  REVIEWER
  SUPPORT
}

enum ReportExportJobStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum ReportExportFormat {
  PDF
  CSV
}

enum ReportDataset {
  OVERVIEW
  OPERATIONS
  CLINICAL
  REFERRALS
}

enum LifecycleEmailPurpose {
  SIGNUP_RECEIVED
  APPROVED
  REJECTED
  SUSPENDED
  REACTIVATED
  EVENT_ASSIGNMENT
  PASSWORD_CHANGED
  DEPROVISIONED
}

enum LifecycleEmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
  RECONCILIATION_REQUIRED
  ESCALATED
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StaffAssignmentRole {
  EVENT_MANAGER
  REGISTRATION
  SCREENER
  REVIEWER
  SUPPORT
}

enum StaffAssignmentStatus {
  ASSIGNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EventRegistrationStatus {
  SIGNED_UP
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum StationType {
  VISUAL_ACUITY
  REFRACTION
  COLOUR_VISION
  EYE_HEALTH
}

enum StationOperationalStatus {
  AVAILABLE
  PAUSED
  OFFLINE
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum ScanResult {
  SUCCESS
  INVALID_QR
  EXPIRED
  ALREADY_CHECKED_IN
  UNAUTHORIZED_STATION
}

enum OverallFlag {
  NORMAL
  REVIEW
  REFER
  URGENT
}

enum ReviewOutcome {
  COMPLETE
  MONITOR
  REFER
  URGENT_ESCALATION
}

enum ClinicalUrgency {
  ROUTINE
  PRIORITY
  URGENT
  EMERGENCY
}

enum ReferralStatus {
  DRAFT
  ISSUED
  SENT
  ACKNOWLEDGED
  CANCELLED
}

enum DocumentType {
  REFERRAL_PDF
  CLINICAL_SUMMARY_PDF
}

enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  QUEUED
  SENDING
  RECONCILIATION_REQUIRED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  COMPLAINT
  CANCELLED
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncActionStatus {
  PENDING
  PROCESSING
  APPLIED
  CONFLICT
  FAILED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ParticipantStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum EmergencyContactStatus {
  ACTIVE
  REMOVED
}

enum ConsentStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum SignaturePurpose {
  CONSENT
  REFERRAL
  REVIEW_DECISION
}

enum AuthOutcome {
  SUCCESS
  FAILED
  DENIED
}

// ==========================================
// AUTHENTICATION & USER MANAGEMENT
// ==========================================

model User {
  id                      String                @id @default(uuid()) @map("user_id") @db.Uuid
  cognitoSub              String?               @unique @map("cognito_sub") @db.Uuid
  username                String?               @unique @db.VarChar(100)
  fullName                String                @map("full_name") @db.VarChar(100)
  email                   String                @unique @db.VarChar(255)
  contactNumber           String?               @map("contact_number") @db.VarChar(20)
  emergencyContact        String?               @map("emergency_contact") @db.VarChar(20)
  dateOfBirth             DateTime?             @map("date_of_birth") @db.Date
  gender                  String?               @db.VarChar(1)
  employeeNumber          String?               @unique @map("employee_number") @db.VarChar(20)
  department              String?               @db.VarChar(100)
  sysRole                 SystemRole            @default(STAFF) @map("system_role")
  designation             String?               @db.VarChar(100)
  status                  UserStatus            @default(ACTIVE)
  failedLoginAttempts     Int                   @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?             @map("locked_until") @db.Timestamptz(3)
  lastLoginAt             DateTime?             @map("last_login_at") @db.Timestamptz(3)
  approvalState           AccountApprovalState  @default(PENDING) @map("approval_state")
  accessState             AccountAccessState    @default(ENABLED) @map("access_state")
  professionalCategory    ProfessionalCategory? @map("professional_category")
  sessionInvalidBefore    DateTime?             @map("session_invalid_before") @db.Timestamptz(3)
  deprovisionedAt         DateTime?             @map("deprovisioned_at") @db.Timestamptz(3)
  deprovisionedById       String?               @map("deprovisioned_by") @db.Uuid
  deprovisionReason       String?               @map("deprovision_reason") @db.VarChar(500)
  providerStateGeneration Int                   @default(0) @map("provider_state_generation")
  consentConfirmation     Boolean               @default(false) @map("consent_confirmation")
  version                 Int                   @default(1)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles                UserRole[]
  credential               UserCredential?
  refreshSessions          RefreshSession[]
  roleAssignmentsMade      UserRole[]                    @relation("UserRoleAssignedBy")
  staffAssignments         StaffAssignment[]             @relation("AssignedUser")
  assignedStaff            StaffAssignment[]             @relation("AssignedBy")
  eventRegistrations       EventRegistration[]           @relation("RegisteredBy")
  revokedQRCodes           QRCodePass[]
  scanLogs                 ScanLog[]
  auditLogs                AuditLog[]
  loginHistories           LoginHistory[]
  securityIncidents        SecurityIncident[]            @relation("IncidentUser")
  resolvedIncidents        SecurityIncident[]            @relation("ResolvedBy")
  reviews                  Review[]                      @relation("ReviewReviewer")
  reviewSignatures         Review[]                      @relation("ReviewSignatureSigner")
  referrals                Referral[]                    @relation("ReferralCreator")
  documentArtifacts        DocumentArtifact[]            @relation("DocumentGenerator")
  syncActions              SyncAction[]                  @relation("SyncActor")
  screeningResults         ScreeningResult[]             @relation("ScreeningRecorder")
  screeningRequestLedgers  ScreeningRequestLedger[]
  movedQueueEntries        QueueMovement[]               @relation("MovedBy")
  notificationDeliveries   NotificationDelivery[]
  eventsCreated            Event[]                       @relation("EventCreatedBy")
  eventsCancelled          Event[]                       @relation("EventCancelledBy")
  eventAuditLogs           EventAuditLog[]               @relation("EventAuditActor")
  authAuditLogs            AuthAuditLog[]
  emergencyContactsCreated ParticipantEmergencyContact[] @relation("EmergencyContactCreatedBy")
  emergencyContactsUpdated ParticipantEmergencyContact[] @relation("EmergencyContactUpdatedBy")
  consentsRecorded         ParticipantConsent[]          @relation("ConsentRecordedBy")
  signatureArtifacts       SignatureArtifact[]           @relation("SignatureArtifactOwner")
  consentVersionsCreated   ConsentFormVersion[]          @relation("ConsentFormVersionCreatedBy")
  registrationChanges      RegistrationStatusHistory[]   @relation("RegistrationStatusChangedBy")
  participantsCreated      Participant[]                 @relation("ParticipantCreatedBy")
  participantsUpdated      Participant[]                 @relation("ParticipantUpdatedBy")
  participantIntakes       ParticipantEventIntake[]      @relation("ParticipantIntakeAttachedBy")
  permissionsCreated       Permission[]                  @relation("PermissionCreatedBy")
  devices                  Device[]
  approvalDecisions        AccountApprovalDecision[]     @relation("ApprovalAccount")
  approvalDecisionsMade    AccountApprovalDecision[]     @relation("ApprovalDecidedBy")
  eventMemberships         EventMembership[]             @relation("MembershipUser")
  membershipsAdded         EventMembership[]             @relation("MembershipAddedBy")
  membershipsRemoved       EventMembership[]             @relation("MembershipRemovedBy")
  membershipRolesAssigned  EventMembershipRole[]         @relation("MembershipRoleAssignedBy")
  providerOperations       AccountProviderOperation[]
  reportExportJobs         ReportExportJob[]             @relation("ReportRequester")
  lifecycleEmails          LifecycleEmailOutbox[]
  domainEvents             DomainEvent[]                 @relation("DomainEventActor")
  deprovisionedBy          User?                         @relation("AccountDeprovision", fields: [deprovisionedById], references: [id], onDelete: SetNull)
  deprovisionedAccounts    User[]                        @relation("AccountDeprovision")

  @@index([status, department])
  @@index([approvalState, accessState, createdAt])
  @@index([professionalCategory])
  @@index([deprovisionedById])
  @@index([email])
  @@map("users")
}

model AccountApprovalDecision {
  id          String                      @id @default(uuid()) @map("approval_decision_id") @db.Uuid
  userId      String                      @map("user_id") @db.Uuid
  decision    AccountApprovalDecisionType
  decidedById String                      @map("decided_by") @db.Uuid
  reason      String?                     @db.VarChar(500)
  decidedAt   DateTime                    @default(now()) @map("decided_at") @db.Timestamptz(3)

  user      User @relation("ApprovalAccount", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedBy User @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, decidedAt])
  @@index([decidedById, decidedAt])
  @@map("account_approval_decisions")
}

model AccountProviderOperation {
  id               String                         @id @default(uuid()) @map("provider_operation_id") @db.Uuid
  userId           String                         @map("user_id") @db.Uuid
  operationType    AccountProviderOperationType   @map("operation_type")
  status           AccountProviderOperationStatus @default(PENDING)
  idempotencyKey   String                         @unique @map("idempotency_key") @db.VarChar(150)
  payload          Json                           @default("{}")
  generation       Int
  attemptCount     Int                            @default(0) @map("attempt_count")
  nextAttemptAt    DateTime                       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt        DateTime?                      @map("claimed_at") @db.Timestamptz(3)
  claimToken       String?                        @map("claim_token") @db.Uuid
  completedAt      DateTime?                      @map("completed_at") @db.Timestamptz(3)
  lastErrorCode    String?                        @map("last_error_code") @db.VarChar(80)
  resolvedAt       DateTime?                      @map("resolved_at") @db.Timestamptz(3)
  resolutionReason String?                        @map("resolution_reason") @db.VarChar(500)
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, generation])
  @@index([status, nextAttemptAt])
  @@index([userId, status, createdAt])
  @@map("account_provider_operations")
}

model UserCredential {
  id           String   @id @default(uuid()) @map("credential_id") @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("user_credentials")
}

model RefreshSession {
  refreshSessionId String    @id @default(uuid()) @map("refresh_session_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  familyId         String    @map("family_id") @db.Uuid
  userAgentHash    String?   @map("user_agent_hash") @db.Char(64)
  networkHint      String?   @map("network_hint") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  reuseDetectedAt  DateTime? @map("reuse_detected_at") @db.Timestamptz(3)
  replacedById     String?   @unique @map("replaced_by_session_id") @db.Uuid

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [refreshSessionId], onDelete: SetNull)
  replaces   RefreshSession? @relation("RefreshRotation")

  @@index([userId, expiresAt])
  @@index([familyId, createdAt])
  @@index([expiresAt, revokedAt])
  @@map("refresh_sessions")
}

model Role {
  id          String   @id @default(uuid()) @map("role_id") @db.Uuid
  roleName    String   @unique @map("role_name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  precedence  Int?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid()) @map("permission_id") @db.Uuid
  permissionName String   @unique @map("permission_name") @db.VarChar(100)
  description    String?  @db.VarChar(255)
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy       User?            @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]

  @@index([createdById])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @map("role_permission_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String   @id @default(uuid()) @map("user_role_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

// ==========================================
// PARTICIPANT & EVENT MANAGEMENT
// ==========================================

model Participant {
  id                   String            @id @default(uuid()) @map("participant_id") @db.Uuid
  participantReference String            @unique @map("participant_reference") @db.VarChar(30)
  nric                 String?           @unique @db.Text
  nricMasked           String?           @map("nric_masked") @db.VarChar(9)
  firstName            String            @map("first_name") @db.VarChar(100)
  lastName             String            @map("last_name") @db.VarChar(100)
  dateOfBirth          DateTime          @map("date_of_birth") @db.Date
  gender               String            @db.VarChar(1)
  race                 String?           @db.VarChar(50)
  nationality          String?           @default("Singaporean") @db.VarChar(50)
  addressStreet        String?           @map("address_street") @db.VarChar(255)
  addressUnit          String?           @map("address_unit") @db.VarChar(20)
  addressPostalCode    String?           @map("address_postal_code") @db.VarChar(10)
  contactNumber        String            @map("contact_number") @db.VarChar(20)
  email                String?           @db.VarChar(255)
  preferredLanguage    String?           @map("preferred_language") @db.VarChar(50)
  accessibilityNotes   String?           @map("accessibility_notes") @db.VarChar(1000)
  status               ParticipantStatus @default(ACTIVE)
  emergencyContact     String            @map("emergency_contact") @db.VarChar(20)
  emergencyContactName String?           @map("emergency_contact_name") @db.VarChar(100)
  consentGiven         Boolean           @map("consent_given")
  createdById          String            @map("created_by") @db.Uuid
  updatedById          String            @map("updated_by") @db.Uuid
  onboardingEventId    String?           @map("onboarding_event_id") @db.Uuid
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  eventRegistrations EventRegistration[]
  eventIntakes       ParticipantEventIntake[]
  emergencyContacts  ParticipantEmergencyContact[]
  consents           ParticipantConsent[]
  createdBy          User                          @relation("ParticipantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy          User                          @relation("ParticipantUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  onboardingEvent    Event?                        @relation("ParticipantOnboardingEvent", fields: [onboardingEventId], references: [eventId], onDelete: SetNull, onUpdate: Cascade)

  @@index([lastName, firstName])
  @@index([contactNumber])
  @@index([dateOfBirth])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
  @@index([onboardingEventId])
  @@map("participants")
}

model Event {
  eventId              String      @id @default(uuid()) @map("event_id") @db.Uuid
  name                 String      @db.VarChar(150)
  description          String?
  bannerKey            String      @default("COMMUNITY_SCREENING") @map("banner_key") @db.VarChar(50)
  artworkDataUrl       String?     @map("artwork_data_url")
  venue                String      @db.VarChar(255)
  address              String?     @db.VarChar(500)
  postalCode           String?     @map("postal_code") @db.VarChar(6)
  latitude             Float?      @db.DoublePrecision
  longitude            Float?      @db.DoublePrecision
  locationProvider     String?     @map("location_provider") @db.VarChar(20)
  locationReference    String?     @map("location_reference") @db.VarChar(255)
  timezone             String      @default("UTC") @db.VarChar(100)
  startsAt             DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime    @map("ends_at") @db.Timestamptz(3)
  capacity             Int
  expectedAttendance   Int?        @map("expected_attendance")
  createIdempotencyKey String?     @map("create_idempotency_key") @db.VarChar(100)
  createPayloadHash    String?     @map("create_payload_hash") @db.Char(64)
  status               EventStatus @default(DRAFT)
  createdByUserId      String      @map("created_by_user_id") @db.Uuid
  cancelledByUserId    String?     @map("cancelled_by_user_id") @db.Uuid
  cancelledAt          DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason   String?     @map("cancellation_reason")
  version              Int         @default(1)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy               User                     @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy             User?                    @relation("EventCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shifts                  Shift[]
  stations                Station[]
  eventDays               EventDay[]
  registrations           EventRegistration[]
  participantIntakes      ParticipantEventIntake[]
  staffAssignments        StaffAssignment[]
  participantConsents     ParticipantConsent[]
  onboardingParticipants  Participant[]            @relation("ParticipantOnboardingEvent")
  signatureArtifacts      SignatureArtifact[]
  screeningRequestLedgers ScreeningRequestLedger[]
  memberships             EventMembership[]
  reportExportJobs        ReportExportJob[]

  @@unique([createdByUserId, createIdempotencyKey])
  @@index([status, startsAt])
  @@index([createdByUserId])
  @@map("events")
}

model EventMembership {
  id            String                @id @default(uuid()) @map("event_membership_id") @db.Uuid
  eventId       String                @map("event_id") @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  status        EventMembershipStatus @default(ACTIVE)
  addedById     String                @map("added_by") @db.Uuid
  addedAt       DateTime              @default(now()) @map("added_at") @db.Timestamptz(3)
  removedById   String?               @map("removed_by") @db.Uuid
  removedAt     DateTime?             @map("removed_at") @db.Timestamptz(3)
  removalReason String?               @map("removal_reason") @db.VarChar(500)

  event     Event                 @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Cascade)
  user      User                  @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  addedBy   User                  @relation("MembershipAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  removedBy User?                 @relation("MembershipRemovedBy", fields: [removedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles     EventMembershipRole[]

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status])
  @@index([addedById])
  @@index([removedById])
  @@map("event_memberships")
}

model EventMembershipRole {
  id           String    @id @default(uuid()) @map("event_membership_role_id") @db.Uuid
  membershipId String    @map("event_membership_id") @db.Uuid
  role         EventRole
  assignedById String    @map("assigned_by") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)

  membership EventMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedBy User            @relation("MembershipRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([membershipId, role])
  @@index([role, membershipId])
  @@index([assignedById])
  @@map("event_membership_roles")
}

model ReportExportJob {
  id                    String                @id @default(uuid()) @map("report_export_job_id") @db.Uuid
  eventId               String                @map("event_id") @db.Uuid
  requestedById         String                @map("requested_by") @db.Uuid
  dataset               ReportDataset         @default(OVERVIEW)
  format                ReportExportFormat    @default(PDF)
  filterSnapshot        Json                  @default("{}") @map("filter_snapshot")
  status                ReportExportJobStatus @default(QUEUED)
  claimToken            String?               @map("claim_token") @db.Uuid
  leaseExpiresAt        DateTime?             @map("lease_expires_at") @db.Timestamptz(3)
  publicationStorageKey String?               @map("publication_storage_key") @db.VarChar(500)
  publicationClaimToken String?               @map("publication_claim_token") @db.Uuid
  attemptCount          Int                   @default(0) @map("attempt_count")
