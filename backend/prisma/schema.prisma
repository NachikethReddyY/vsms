  user          User?                      @relation(fields: [userId], references: [id])

  @@map("notification_deliveries")
}

model SyncAction {
  id         String           @id @default(uuid()) @map("sync_action_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
