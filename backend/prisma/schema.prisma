// Non-clinical account and assignment mail remains separate from encrypted
// SES referral deliveries. Metadata is template input, never an arbitrary body.
model LifecycleEmailOutbox {
  id                String                @id @default(uuid()) @map("lifecycle_email_id") @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  purpose           LifecycleEmailPurpose
  provider          String                @default("GOOGLE_WORKSPACE") @db.VarChar(40)
  templateVersion   Int                   @default(1) @map("template_version")
  metadata          Json                  @default("{}")
  idempotencyKey    String                @unique @map("idempotency_key") @db.VarChar(180)
  status            LifecycleEmailStatus  @default(QUEUED)
  claimToken        String?               @map("claim_token") @db.Uuid
  leaseExpiresAt    DateTime?             @map("lease_expires_at") @db.Timestamptz(3)
  attemptCount      Int                   @default(0) @map("attempt_count")
  maxAttempts       Int                   @default(5) @map("max_attempts")
  nextAttemptAt     DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  providerMessageId String?               @map("provider_message_id") @db.VarChar(255)
  failureCode       String?               @map("failure_code") @db.VarChar(80)
  acceptedAt        DateTime?             @map("accepted_at") @db.Timestamptz(3)
  failedAt          DateTime?             @map("failed_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([userId, createdAt])
  @@map("lifecycle_email_outbox")
}

// Durable replay ledger for authenticated provider lifecycle events. Provider
// payloads and recipient addresses are deliberately not retained here.
model ProviderEventReceipt {
  id                    String   @id @default(uuid()) @map("provider_event_receipt_id") @db.Uuid
  provider              String   @db.VarChar(30)
  providerEventId       String   @unique @map("provider_event_id") @db.VarChar(255)
  providerMessageIdHash String   @map("provider_message_id_hash") @db.Char(64)
  deliveryId            String?  @map("delivery_id") @db.Uuid
  eventType             String   @map("event_type") @db.VarChar(40)
  appliedStatus         String?  @map("applied_status") @db.VarChar(40)
  receivedAt            DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([deliveryId, receivedAt])
  @@index([providerMessageIdHash, receivedAt])
  @@map("provider_event_receipts")
}

// Durable, event-detached outbox. These rows must survive deletion of the event
// so filesystem cleanup can be retried after the database transaction commits.
model ArtifactCleanupTask {
  id            String    @id @default(uuid()) @map("cleanup_task_id") @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  artifactType  String    @map("artifact_type") @db.VarChar(40)
  storageKey    String    @map("storage_key") @db.VarChar(500)
  status        String    @default("PENDING") @db.VarChar(20)
  attemptCount  Int       @default(0) @map("attempt_count")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error") @db.VarChar(255)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([eventId, artifactType, storageKey])
  @@index([status, nextAttemptAt])
  @@index([eventId, status])
  @@map("artifact_cleanup_tasks")
}

// Durable transactional outbox for domain events. Producers write a row inside
// the same database transaction that commits the state change; the dedicated
// domain-event worker claims rows and dispatches them to registered handlers
// with retry, backoff, and dead-letter semantics (at-least-once delivery).
// Payloads are sanitized metadata only - clinical bodies, NRIC, and pass tokens
// are forbidden, mirroring the sync ledger policy.
model DomainEvent {
  id            String            @id @default(uuid()) @map("domain_event_id") @db.Uuid
  type          String            @map("type") @db.VarChar(100)
  aggregateType String            @map("aggregate_type") @db.VarChar(50)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  correlationId String            @map("correlation_id") @db.Uuid
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  payload       Json              @default("{}")
  status        DomainEventStatus @default(PENDING)
  attemptCount  Int               @default(0) @map("attempt_count")
  maxAttempts   Int               @default(5) @map("max_attempts")
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt     DateTime?         @map("claimed_at") @db.Timestamptz(3)
  claimToken    String?           @map("claim_token") @db.Uuid
  lastErrorCode String?           @map("last_error_code") @db.VarChar(80)
  dispatchedAt  DateTime?         @map("dispatched_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor User? @relation("DomainEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, nextAttemptAt])
  @@index([type, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([correlationId])
  @@map("domain_events")
}

model SyncAction {
  id                  String           @id @default(uuid()) @map("sync_action_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  eventId             String?          @map("event_id") @db.Uuid
  stationId           String?          @map("station_id") @db.Uuid
  clientActionId      String?          @map("client_action_id") @db.Uuid
  requestFingerprint  String?          @map("request_fingerprint") @db.Char(64)
  operation           SyncOperation
  entityType          String           @map("entity_type") @db.VarChar(50)
  entityId            String           @map("entity_id") @db.Uuid
  // Safe metadata only. Clinical bodies, participant profiles, NRIC, and pass tokens are forbidden here.
  payload             Json
  responseSnapshot    Json?            @map("response_snapshot")
  status              SyncActionStatus @default(PENDING)
  retryCount          Int              @default(0) @map("retry_count")
  version             Int              @default(0)
  processingStartedAt DateTime?        @map("processing_started_at") @db.Timestamptz(3)
  errorCode           String?          @map("error_code") @db.VarChar(64)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                   @relation("SyncActor", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transitions SyncActionTransition[]

  @@unique([userId, clientActionId])
  @@index([eventId, status, createdAt])
  @@index([stationId, status])
  @@map("sync_actions")
}

model SyncActionTransition {
  id           String           @id @default(uuid()) @map("sync_transition_id") @db.Uuid
  syncActionId String           @map("sync_action_id") @db.Uuid
  sequence     Int
  status       SyncActionStatus
  retryCount   Int              @map("retry_count")
  errorCode    String?          @map("error_code") @db.VarChar(64)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  syncAction SyncAction @relation(fields: [syncActionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([syncActionId, sequence])
  @@index([syncActionId, createdAt])
  @@index([status, createdAt])
  @@map("sync_action_transitions")
}

