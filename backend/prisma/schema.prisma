// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SystemRole {
  ADMIN
  EVENT_MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EventAuditAction {
  CREATED
  UPDATED
  PUBLISHED
  STARTED
  COMPLETED
  CANCELLED
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StaffAssignmentRole {
  EVENT_MANAGER
  REGISTRATION
  SCREENER
  REVIEWER
  SUPPORT
}

enum StaffAssignmentStatus {
  ASSIGNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReviewOutcome {
  COMPLETE
  MONITOR
  REFER
  URGENT_ESCALATION
}

enum ClinicalUrgency {
  ROUTINE
  PRIORITY
  URGENT
  EMERGENCY
}

enum ReferralStatus {
  DRAFT
  ISSUED
  SENT
  ACKNOWLEDGED
  CANCELLED
}

enum DocumentType {
  REFERRAL_PDF
  CLINICAL_SUMMARY_PDF
}

enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  QUEUED
  SENDING
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncActionStatus {
  PENDING
  PROCESSING
  APPLIED
  CONFLICT
  FAILED
}

model Event {
  eventId            String      @id @default(uuid()) @map("event_id") @db.Uuid
  name               String      @db.VarChar(150)
  description        String?
  bannerKey          String      @default("COMMUNITY_SCREENING") @map("banner_key") @db.VarChar(50)
  venue              String      @db.VarChar(255)
  timezone           String      @default("UTC") @db.VarChar(100)
  startsAt           DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime    @map("ends_at") @db.Timestamptz(3)
  capacity           Int
  status             EventStatus @default(DRAFT)
  createdByUserId    String      @map("created_by_user_id") @db.Uuid
  cancelledByUserId  String?     @map("cancelled_by_user_id") @db.Uuid
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?     @map("cancellation_reason")
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User            @relation("EventCreatedBy", fields: [createdByUserId], references: [userId], onDelete: Restrict)
  cancelledBy User?           @relation("EventCancelledBy", fields: [cancelledByUserId], references: [userId], onDelete: Restrict)
  shifts      Shift[]
  auditLogs   EventAuditLog[]

  @@index([status, startsAt])
  @@index([createdByUserId])
  @@map("events")
}

model User {
  userId              String     @id @default(uuid()) @map("user_id") @db.Uuid
  username            String     @unique @db.VarChar(100)
  email               String     @unique @db.VarChar(255)
  passwordHash        String     @map("password_hash")
  systemRole          SystemRole @default(STAFF) @map("system_role")
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshSessions    RefreshSession[]
  eventsCreated      Event[]            @relation("EventCreatedBy")
  eventsCancelled    Event[]            @relation("EventCancelledBy")
  staffAssignments   StaffAssignment[]  @relation("StaffAssignmentUser")
  assignmentsCreated StaffAssignment[]  @relation("StaffAssignmentAssigner")
  reviewsPerformed   Review[]           @relation("ReviewReviewer")
  referralsCreated   Referral[]         @relation("ReferralCreator")
  documentsGenerated DocumentArtifact[] @relation("DocumentGenerator")
  syncActions        SyncAction[]       @relation("SyncActor")
  eventAuditLogs     EventAuditLog[]    @relation("EventAuditActor")

  @@index([systemRole, status])
  @@index([status, lockedUntil])
  @@map("users")
}

model RefreshSession {
  refreshSessionId String    @id @default(uuid()) @map("refresh_session_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  reuseDetectedAt  DateTime? @map("reuse_detected_at") @db.Timestamptz(3)
  replacedById     String?   @unique @map("replaced_by_session_id") @db.Uuid
  userAgentHash    String?   @map("user_agent_hash") @db.Char(64)
  networkHint      String?   @map("network_hint") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  replacedBy RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [refreshSessionId], onDelete: SetNull)
  replaces   RefreshSession? @relation("RefreshRotation")

  @@index([userId, expiresAt])
  @@index([familyId, createdAt])
  @@index([expiresAt, revokedAt])
  @@map("refresh_sessions")
}

model EventAuditLog {
  eventAuditLogId String           @id @default(uuid()) @map("event_audit_log_id") @db.Uuid
  eventId         String           @map("event_id") @db.Uuid
  actorUserId     String           @map("actor_user_id") @db.Uuid
  action          EventAuditAction
  beforeSnapshot  Json?            @map("before_snapshot")
  afterSnapshot   Json?            @map("after_snapshot")
  correlationId   String           @map("correlation_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  actor User  @relation("EventAuditActor", fields: [actorUserId], references: [userId], onDelete: Restrict)

  @@index([eventId, createdAt, eventAuditLogId])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@map("event_audit_logs")
}

model Shift {
  shiftId       String      @id @default(uuid()) @map("shift_id") @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  name          String      @db.VarChar(100)
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(3)
  requiredStaff Int         @default(1) @map("required_staff")
  status        ShiftStatus @default(PLANNED)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event            Event             @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  staffAssignments StaffAssignment[]

  @@unique([eventId, name, startsAt])
  @@index([eventId, startsAt])
  @@map("shifts")
}

model StaffAssignment {
  staffAssignmentId String                @id @default(uuid()) @map("staff_assignment_id") @db.Uuid
  shiftId           String                @map("shift_id") @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  eventStationId    String?               @map("event_station_id") @db.Uuid
  assignmentRole    StaffAssignmentRole   @map("assignment_role")
  status            StaffAssignmentStatus @default(ASSIGNED)
  assignedByUserId  String                @map("assigned_by_user_id") @db.Uuid
  notes             String?
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  shift      Shift @relation(fields: [shiftId], references: [shiftId], onDelete: Cascade)
  user       User  @relation("StaffAssignmentUser", fields: [userId], references: [userId], onDelete: Restrict)
  assignedBy User  @relation("StaffAssignmentAssigner", fields: [assignedByUserId], references: [userId], onDelete: Restrict)

  @@unique([shiftId, userId, eventStationId])
  @@index([userId, status])
  @@index([eventStationId])
  @@index([assignedByUserId])
  @@map("staff_assignments")
}

model Review {
  reviewId           String          @id @default(uuid()) @map("review_id") @db.Uuid
  registrationId     String          @map("registration_id") @db.Uuid
  reviewedByUserId   String          @map("reviewed_by_user_id") @db.Uuid
  outcome            ReviewOutcome
  urgency            ClinicalUrgency @default(ROUTINE)
  clinicalSummary    String          @map("clinical_summary")
  recommendations    String?
  reviewedAt         DateTime        @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  version            Int             @default(1)
  supersedesReviewId String?         @unique @map("supersedes_review_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  supersedes   Review?            @relation("ReviewVersions", fields: [supersedesReviewId], references: [reviewId], onDelete: SetNull)
  supersededBy Review?            @relation("ReviewVersions")
  referrals    Referral[]
  documents    DocumentArtifact[]
  reviewer     User               @relation("ReviewReviewer", fields: [reviewedByUserId], references: [userId], onDelete: Restrict)

  @@unique([registrationId, version])
  @@index([registrationId, reviewedAt])
  @@index([reviewedByUserId])
  @@index([outcome, urgency])
  @@map("reviews")
}

model Referral {
  referralId       String          @id @default(uuid()) @map("referral_id") @db.Uuid
  reviewId         String          @map("review_id") @db.Uuid
  registrationId   String          @map("registration_id") @db.Uuid
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  destinationName  String          @map("destination_name") @db.VarChar(200)
  destinationEmail String?         @map("destination_email") @db.VarChar(255)
  reason           String
  instructions     String?
  urgency          ClinicalUrgency
  status           ReferralStatus  @default(DRAFT)
  referredAt       DateTime?       @map("referred_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  review                 Review                 @relation(fields: [reviewId], references: [reviewId], onDelete: Restrict)
  documents              DocumentArtifact[]
  notificationDeliveries NotificationDelivery[]
  createdBy              User                   @relation("ReferralCreator", fields: [createdByUserId], references: [userId], onDelete: Restrict)

  @@index([registrationId, createdAt])
  @@index([reviewId])
  @@index([createdByUserId])
  @@index([status, urgency])
  @@map("referrals")
}

model DocumentArtifact {
  documentId        String       @id @default(uuid()) @map("document_id") @db.Uuid
  reviewId          String       @map("review_id") @db.Uuid
  referralId        String?      @map("referral_id") @db.Uuid
  documentType      DocumentType @map("document_type")
  version           Int          @default(1)
  storageKey        String       @map("storage_key")
  contentHash       String       @map("content_hash") @db.Char(64)
  mimeType          String       @map("mime_type") @db.VarChar(100)
  sizeBytes         BigInt       @map("size_bytes")
  generatedByUserId String       @map("generated_by_user_id") @db.Uuid
  generatedAt       DateTime     @default(now()) @map("generated_at") @db.Timestamptz(3)
  expiresAt         DateTime?    @map("expires_at") @db.Timestamptz(3)

  review                 Review                 @relation(fields: [reviewId], references: [reviewId], onDelete: Restrict)
  referral               Referral?              @relation(fields: [referralId], references: [referralId], onDelete: Restrict)
  notificationDeliveries NotificationDelivery[]
  generatedBy            User                   @relation("DocumentGenerator", fields: [generatedByUserId], references: [userId], onDelete: Restrict)

  @@unique([reviewId, documentType, version])
  @@index([referralId])
  @@index([generatedByUserId])
  @@map("document_artifacts")
}

model NotificationDelivery {
  notificationDeliveryId    String                     @id @default(uuid()) @map("notification_delivery_id") @db.Uuid
  referralId                String?                    @map("referral_id") @db.Uuid
  documentId                String?                    @map("document_id") @db.Uuid
  channel                   NotificationChannel        @default(EMAIL)
  recipientAddressEncrypted Bytes                      @map("recipient_address_encrypted")
  templateKey               String                     @map("template_key") @db.VarChar(100)
  providerMessageId         String?                    @map("provider_message_id") @db.VarChar(255)
  status                    NotificationDeliveryStatus @default(QUEUED)
  attemptCount              Int                        @default(0) @map("attempt_count")
  lastAttemptAt             DateTime?                  @map("last_attempt_at") @db.Timestamptz(3)
  deliveredAt               DateTime?                  @map("delivered_at") @db.Timestamptz(3)
  failureCode               String?                    @map("failure_code") @db.VarChar(100)
  failureMessage            String?                    @map("failure_message")
  idempotencyKey            String                     @unique @map("idempotency_key") @db.VarChar(255)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  referral Referral?         @relation(fields: [referralId], references: [referralId], onDelete: Restrict)
  document DocumentArtifact? @relation(fields: [documentId], references: [documentId], onDelete: Restrict)

  @@index([referralId])
  @@index([documentId])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

model SyncAction {
  syncActionId   String           @id @default(uuid()) @map("sync_action_id") @db.Uuid
  deviceId       String           @map("device_id") @db.VarChar(255)
  actorUserId    String?          @map("actor_user_id") @db.Uuid
  registrationId String?          @map("registration_id") @db.Uuid
  entityType     String           @map("entity_type") @db.VarChar(100)
  entityId       String           @map("entity_id") @db.Uuid
  operation      SyncOperation
  baseVersion    Int?             @map("base_version")
  payload        Json
  status         SyncActionStatus @default(PENDING)
  attemptCount   Int              @default(0) @map("attempt_count")
  errorCode      String?          @map("error_code") @db.VarChar(100)
  errorDetails   Json?            @map("error_details")
  receivedAt     DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime?        @map("processed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor User? @relation("SyncActor", fields: [actorUserId], references: [userId], onDelete: SetNull)

  @@unique([deviceId, syncActionId])
  @@index([status, receivedAt])
  @@index([entityType, entityId])
  @@index([registrationId])
  @@index([actorUserId])
  @@map("sync_actions")
}
