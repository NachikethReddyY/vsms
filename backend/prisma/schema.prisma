// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum AccountStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
}

enum RoleName {
    ADMINISTRATOR
    EVENT_MANAGER
    REGISTRATION_OFFICER
    SCREENER
    REVIEWER
}

enum AssignmentStatus {
    ACTIVE
    COMPLETED
    CANCELLED
}

enum RegistrationStatus {
    REGISTERED
    CHECKED_IN
    COMPLETED
    CANCELLED
}

model Role {
    roleId      String   @id @default(uuid()) @map("role_id") @db.Uuid
    roleName    RoleName @unique @map("role_name")
    description String?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    users Users[]

    @@map("Role")
}

model Users {
    userId String @id @default(uuid()) @map("user_id") @db.Uuid

    roleId       String @map("role_id") @db.Uuid
    departmentId String @map("department_id") @db.Uuid

    cognitoSub String? @unique @map("cognito_sub") @db.Uuid

    staffId String @unique @map("staff_id") @db.VarChar(20)

    fullName String @map("full_name") @db.VarChar(100)

    email String @unique @db.VarChar(255)

    phoneNumber String? @map("phone_number") @db.VarChar(20)

    profilePhotoUrl String? @map("profile_photo_url") @db.VarChar(255)

    accountStatus AccountStatus @default(ACTIVE) @map("account_status")

    lastLoginAt DateTime? @map("last_login_at")

    createdAt DateTime @default(now()) @map("created_at")

    updatedAt DateTime @updatedAt @map("updated_at")

    role Role @relation(fields: [roleId], references: [roleId])

    department Department @relation(fields: [departmentId], references: [departmentId])

    createdEvents Event[] @relation("CreatedEvents")

    stationAssignments StationAssignment[]

    assignedStations ScreeningStation[] @relation("AssignedStations")

    recordedResults ScreeningResult[] @relation("RecordedResults")

    reviewedReferrals Referral[] @relation("ReviewedReferrals")

    auditLogs AuditLog[]

    @@map("users")
}

model Department {
    departmentId String @id @default(uuid()) @map("department_id") @db.Uuid

    departmentName String @unique @map("department_name") @db.VarChar(100)

    description String?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    users Users[]

    @@map("Department")
}

model Gender {
    genderId String @id @default(uuid()) @map("gender_id") @db.Uuid

    genderName String @unique @map("gender_name") @db.VarChar(20)

    participants Participant[]

    @@map("Gender")
}

model Nationality {
    nationalityId String @id @default(uuid()) @map("nationality_id") @db.Uuid

    countryName String @unique @map("country_name") @db.VarChar(100)

    countryCode String @unique @map("country_code") @db.Char(3)

    participants Participant[]

    @@map("Nationality")
}

model Participant {
    participantId String @id @default(uuid()) @map("participant_id") @db.Uuid

    genderId String @map("gender_id") @db.Uuid

    nationalityId String @map("nationality_id") @db.Uuid

    singpassUuid String? @unique @map("singpass_uuid") @db.Uuid

    nricFin String @unique @map("nric_fin") @db.VarChar(12)

    fullName String @map("full_name") @db.VarChar(100)

    dateOfBirth DateTime @map("date_of_birth") @db.Date

    phoneNumber String @map("phone_number") @db.VarChar(20)

    email String? @db.VarChar(255)

    address String?

    postalCode String? @map("postal_code") @db.VarChar(10)

    createdAt DateTime @default(now()) @map("created_at")

    updatedAt DateTime @updatedAt @map("updated_at")

    gender Gender @relation(fields: [genderId], references: [genderId])

    nationality Nationality @relation(fields: [nationalityId], references: [nationalityId])

    registrations ParticipantRegistration[]

    emergencyContacts EmergencyContact[]

    consents Consent[]

    @@index([fullName])
    @@index([phoneNumber])
    @@map("Participant")
}

model EmergencyContact {
    contactId String @id @default(uuid()) @map("contact_id") @db.Uuid

    participantId String @map("participant_id") @db.Uuid

    contactName String @map("contact_name") @db.VarChar(100)

    relationship String @db.VarChar(50)

    phoneNumber String @map("phone_number") @db.VarChar(20)

    participant Participant @relation(fields: [participantId], references: [participantId])

    @@map("Emergency_Contact")
}

model Consent {
    consentId String @id @default(uuid()) @map("consent_id") @db.Uuid

    participantId String @map("participant_id") @db.Uuid

    consentGiven Boolean @map("consent_given")

    consentDate DateTime @map("consent_date")

    consentVersion String @map("consent_version") @db.VarChar(20)

    participant Participant @relation(fields: [participantId], references: [participantId])

    @@map("Consent")
}

model Event {
    eventId String @id @default(uuid()) @map("event_id") @db.Uuid

    createdBy String @map("created_by") @db.Uuid

    eventName String @map("event_name") @db.VarChar(100)

    description String?

    venue String @db.VarChar(255)

    eventDate DateTime @map("event_date") @db.Date

    startTime DateTime @map("start_time") @db.Time

    endTime DateTime @map("end_time") @db.Time

    capacity Int

    registeredCount Int @default(0) @map("registered_count")

    status String @db.VarChar(20)

    createdAt DateTime @default(now()) @map("created_at")

    updatedAt DateTime @updatedAt @map("updated_at")

    creator Users @relation("CreatedEvents", fields: [createdBy], references: [userId])

    registrations ParticipantRegistration[]

    stations ScreeningStation[]

    @@map("Events")
}

model ParticipantRegistration {
    registrationId String @id @default(uuid()) @map("registration_id") @db.Uuid

    participantId String @map("participant_id") @db.Uuid

    eventId String @map("event_id") @db.Uuid

    qrCode String? @map("qr_code") @db.VarChar(255)

    registrationStatus RegistrationStatus @default(REGISTERED) @map("registration_status")

    registeredAt DateTime @default(now()) @map("registered_at")

    checkedInAt DateTime? @map("checked_in_at")

    participant Participant @relation(fields: [participantId], references: [participantId])

    event Event @relation(fields: [eventId], references: [eventId])

    screeningResults ScreeningResult[]

    referrals Referral[]

    queue Queue?

    syncQueue SyncQueue?

    @@unique([participantId, eventId])
    @@map("Participant_Registration")
}

model ScreeningStation {
    stationId String @id @default(uuid()) @map("station_id") @db.Uuid

    eventId String @map("event_id") @db.Uuid

    assignedUserId String? @map("assigned_user_id") @db.Uuid

    stationName String @map("station_name") @db.VarChar(100)

    stationOrder Int @map("station_order")

    location String @db.VarChar(100)

    status String @db.VarChar(20)

    createdAt DateTime @default(now()) @map("created_at")

    updatedAt DateTime @updatedAt @map("updated_at")

    event Event @relation(fields: [eventId], references: [eventId])

    assignedUser Users? @relation("AssignedStations", fields: [assignedUserId], references: [userId])

    assignments StationAssignment[]

    screeningResults ScreeningResult[]

    queues Queue[]

    @@map("Screening_Station")
}

model StationAssignment {
    assignmentId String @id @default(uuid()) @map("assignment_id") @db.Uuid

    stationId String @map("station_id") @db.Uuid

    userId String @map("user_id") @db.Uuid

    shiftStart DateTime @map("shift_start")

    shiftEnd DateTime @map("shift_end")

    assignmentStatus AssignmentStatus @default(ACTIVE) @map("assignment_status")

    createdAt DateTime @default(now()) @map("created_at")

    updatedAt DateTime @updatedAt @map("updated_at")

    station ScreeningStation @relation(fields: [stationId], references: [stationId])

    user Users @relation(fields: [userId], references: [userId])

    @@map("Station_Assignment")
}

model ScreeningResult {
    resultId String @id @default(uuid()) @map("result_id") @db.Uuid

    registrationId String @map("registration_id") @db.Uuid

    stationId String @map("station_id") @db.Uuid

    recordedBy String @map("recorded_by") @db.Uuid

    screeningType String @map("screening_type") @db.VarChar(50)

    resultData Json @map("result_data")

    flagged Boolean @default(false)

    remarks String?

    syncStatus String @default("SYNCED") @map("sync_status") @db.VarChar(20)

    createdAt DateTime @default(now()) @map("created_at")

    updatedAt DateTime @updatedAt @map("updated_at")

    registration ParticipantRegistration @relation(fields: [registrationId], references: [registrationId])

    station ScreeningStation @relation(fields: [stationId], references: [stationId])

    recorder Users @relation("RecordedResults", fields: [recordedBy], references: [userId])

    @@map("Screening_Result")
}

model Referral {
    referralId String @id @default(uuid()) @map("referral_id") @db.Uuid

    resultId String @map("result_id") @db.Uuid

    registrationId String @map("registration_id") @db.Uuid

    reviewedBy String @map("reviewed_by") @db.Uuid

    referralReason String

    referredTo String @map("referred_to") @db.VarChar(100)

    referralStatus String @map("referral_status") @db.VarChar(20)

    notes String?

    referralDate DateTime @map("referral_date")

    createdAt DateTime @default(now()) @map("created_at")

    updatedAt DateTime @updatedAt @map("updated_at")

    reviewer Users @relation("ReviewedReferrals", fields: [reviewedBy], references: [userId])

    registration ParticipantRegistration @relation(fields: [registrationId], references: [registrationId])

    @@map("Referral")
}

model Queue {
    queueId String @id @default(uuid()) @map("queue_id") @db.Uuid

    registrationId String @unique @map("registration_id") @db.Uuid

    stationId String @map("station_id") @db.Uuid

    queueNumber String @map("queue_number") @db.VarChar(20)

    checkInTime DateTime? @map("check_in_time")

    checkOutTime DateTime? @map("check_out_time")

    createdAt DateTime @default(now()) @map("created_at")

    updatedAt DateTime @updatedAt @map("updated_at")

    registration ParticipantRegistration @relation(fields: [registrationId], references: [registrationId])

    station ScreeningStation @relation(fields: [stationId], references: [stationId])

    @@map("Queue")
}

model SyncQueue {
    syncId String @id @default(uuid()) @map("sync_id") @db.Uuid

    registrationId String @unique @map("registration_id") @db.Uuid

    action String @db.VarChar(50)

    payload Json

    syncStatus String @map("sync_status") @db.VarChar(20)

    retryCount Int @default(0) @map("retry_count")

    lastSyncAt DateTime? @map("last_sync_at")

    createdAt DateTime @default(now()) @map("created_at")

    registration ParticipantRegistration @relation(fields: [registrationId], references: [registrationId])

    @@map("SyncQueue")
}

model AuditLog {
    auditId String @id @default(uuid()) @map("audit_id") @db.Uuid

    userId String @map("user_id") @db.Uuid

    action String @db.VarChar(100)

    entityName String @map("entity_name") @db.VarChar(100)

    entityId String @map("entity_id") @db.Uuid

    ipAddress String? @map("ip_address") @db.VarChar(45)

    userAgent String? @map("user_agent")

    metadata Json?

    createdAt DateTime @default(now()) @map("created_at")

    user Users @relation(fields: [userId], references: [userId])

    @@map("AuditLog")
}
