// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SystemRole {
  ADMIN
  EVENT_MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
  INACTIVE
  SUSPENDED
}

enum EventAuditAction {
  CREATED
  UPDATED
  PUBLISHED
  STARTED
  COMPLETED
  CANCELLED
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StaffAssignmentRole {
  EVENT_MANAGER
  REGISTRATION
  SCREENER
  REVIEWER
  SUPPORT
}

enum StaffAssignmentStatus {
  ASSIGNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EventRegistrationStatus {
  SIGNED_UP
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum StationType {
  VISUAL_ACUITY
  REFRACTION
  COLOUR_VISION
  EYE_HEALTH
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum ScanResult {
  SUCCESS
  INVALID_QR
  EXPIRED
  ALREADY_CHECKED_IN
  UNAUTHORIZED_STATION
}

enum OverallFlag {
  NORMAL
  REVIEW
  REFER
  URGENT
}

enum ReviewOutcome {
  COMPLETE
  MONITOR
  REFER
  URGENT_ESCALATION
}

enum ClinicalUrgency {
  ROUTINE
  PRIORITY
  URGENT
  EMERGENCY
}

enum ReferralStatus {
  DRAFT
  ISSUED
  SENT
  ACKNOWLEDGED
  CANCELLED
}

enum DocumentType {
  REFERRAL_PDF
  CLINICAL_SUMMARY_PDF
}

enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  QUEUED
  SENDING
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncActionStatus {
  PENDING
  PROCESSING
  APPLIED
  CONFLICT
  FAILED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ParticipantStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum EmergencyContactStatus {
  ACTIVE
  REMOVED
}

enum ConsentStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum AuthOutcome {
  SUCCESS
  FAILED
  DENIED
}

// ==========================================
// AUTHENTICATION & USER MANAGEMENT
// ==========================================

model User {
  id                  String     @id @default(uuid()) @map("user_id") @db.Uuid
  cognitoSub          String?    @unique @map("cognito_sub") @db.Uuid
  username            String?    @unique @db.VarChar(100)
  fullName            String     @map("full_name") @db.VarChar(100)
  email               String     @unique @db.VarChar(255)
  contactNumber       String?    @map("contact_number") @db.VarChar(20)
  emergencyContact    String?    @map("emergency_contact") @db.VarChar(20)
  dateOfBirth         DateTime?  @map("date_of_birth") @db.Date
  gender              String?    @db.VarChar(1)
  employeeNumber      String     @unique @map("employee_number") @db.VarChar(20)
  department          String?    @db.VarChar(100)
  sysRole             SystemRole @default(STAFF) @map("system_role")
  designation         String?    @db.VarChar(100)
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  consentConfirmation Boolean    @default(false) @map("consent_confirmation")
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles                UserRole[]
  credential               UserCredential?
  refreshSessions          RefreshSession[]
  roleAssignmentsMade      UserRole[]                    @relation("UserRoleAssignedBy")
  staffAssignments         StaffAssignment[]             @relation("AssignedUser")
  assignedStaff            StaffAssignment[]             @relation("AssignedBy")
  eventRegistrations       EventRegistration[]           @relation("RegisteredBy")
  revokedQRCodes           QRCodePass[]
  scanLogs                 ScanLog[]
  auditLogs                AuditLog[]
  loginHistories           LoginHistory[]
  securityIncidents        SecurityIncident[]            @relation("IncidentUser")
  resolvedIncidents        SecurityIncident[]            @relation("ResolvedBy")
  reviews                  Review[]                      @relation("ReviewReviewer")
  referrals                Referral[]                    @relation("ReferralCreator")
  documentArtifacts        DocumentArtifact[]            @relation("DocumentGenerator")
  syncActions              SyncAction[]                  @relation("SyncActor")
  screeningResults         ScreeningResult[]             @relation("ScreeningRecorder")
  movedQueueEntries        QueueMovement[]               @relation("MovedBy")
  notificationDeliveries   NotificationDelivery[]
  eventsCreated            Event[]                       @relation("EventCreatedBy")
  eventsCancelled          Event[]                       @relation("EventCancelledBy")
  eventAuditLogs           EventAuditLog[]               @relation("EventAuditActor")
  authAuditLogs            AuthAuditLog[]
  emergencyContactsCreated ParticipantEmergencyContact[] @relation("EmergencyContactCreatedBy")
  emergencyContactsUpdated ParticipantEmergencyContact[] @relation("EmergencyContactUpdatedBy")
  consentsRecorded         ParticipantConsent[]          @relation("ConsentRecordedBy")
  consentVersionsCreated   ConsentFormVersion[]          @relation("ConsentFormVersionCreatedBy")
  registrationChanges      RegistrationStatusHistory[]   @relation("RegistrationStatusChangedBy")
  participantsCreated      Participant[]                 @relation("ParticipantCreatedBy")
  participantsUpdated      Participant[]                 @relation("ParticipantUpdatedBy")
  permissionsCreated       Permission[]                  @relation("PermissionCreatedBy")
  devices                  Device[]

  @@index([status, department])
  @@index([email])
  @@map("users")
}

model UserCredential {
  id           String   @id @default(uuid()) @map("credential_id") @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("user_credentials")
}

model RefreshSession {
  refreshSessionId String    @id @default(uuid()) @map("refresh_session_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  familyId         String    @map("family_id") @db.Uuid
  userAgentHash    String?   @map("user_agent_hash") @db.Char(64)
  networkHint      String?   @map("network_hint") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  reuseDetectedAt  DateTime? @map("reuse_detected_at") @db.Timestamptz(3)
  replacedById     String?   @unique @map("replaced_by_session_id") @db.Uuid

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [refreshSessionId], onDelete: SetNull)
  replaces   RefreshSession? @relation("RefreshRotation")

  @@index([userId, expiresAt])
  @@index([familyId, createdAt])
  @@index([expiresAt, revokedAt])
  @@map("refresh_sessions")
}

model Role {
  id          String   @id @default(uuid()) @map("role_id") @db.Uuid
  roleName    String   @unique @map("role_name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  precedence  Int?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid()) @map("permission_id") @db.Uuid
  permissionName String   @unique @map("permission_name") @db.VarChar(100)
  description    String?  @db.VarChar(255)
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy       User?            @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]

  @@index([createdById])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @map("role_permission_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String   @id @default(uuid()) @map("user_role_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

// ==========================================
// PARTICIPANT & EVENT MANAGEMENT
// ==========================================

model Participant {
  id                   String            @id @default(uuid()) @map("participant_id") @db.Uuid
  participantReference String            @unique @map("participant_reference") @db.VarChar(30)
  nric                 String?           @unique @db.Text
  nricMasked           String?           @map("nric_masked") @db.VarChar(9)
  firstName            String            @map("first_name") @db.VarChar(100)
  lastName             String            @map("last_name") @db.VarChar(100)
  dateOfBirth          DateTime          @map("date_of_birth") @db.Date
  gender               String            @db.VarChar(1)
  race                 String?           @db.VarChar(50)
  nationality          String?           @default("Singaporean") @db.VarChar(50)
  addressStreet        String?           @map("address_street") @db.VarChar(255)
  addressUnit          String?           @map("address_unit") @db.VarChar(20)
  addressPostalCode    String?           @map("address_postal_code") @db.VarChar(10)
  contactNumber        String            @map("contact_number") @db.VarChar(20)
  email                String?           @db.VarChar(255)
  preferredLanguage    String?           @map("preferred_language") @db.VarChar(50)
  accessibilityNotes   String?           @map("accessibility_notes") @db.VarChar(1000)
  status               ParticipantStatus @default(ACTIVE)
  emergencyContact     String            @map("emergency_contact") @db.VarChar(20)
  emergencyContactName String?           @map("emergency_contact_name") @db.VarChar(100)
  consentGiven         Boolean           @map("consent_given")
  createdById          String            @map("created_by") @db.Uuid
  updatedById          String            @map("updated_by") @db.Uuid
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  eventRegistrations EventRegistration[]
  emergencyContacts  ParticipantEmergencyContact[]
  consents           ParticipantConsent[]
  createdBy          User                          @relation("ParticipantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy          User                          @relation("ParticipantUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([lastName, firstName])
  @@index([contactNumber])
  @@index([dateOfBirth])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
  @@map("participants")
}

model Event {
  eventId              String      @id @default(uuid()) @map("event_id") @db.Uuid
  name                 String      @db.VarChar(150)
  description          String?
  bannerKey            String      @default("COMMUNITY_SCREENING") @map("banner_key") @db.VarChar(50)
  artworkDataUrl       String?     @map("artwork_data_url")
  venue                String      @db.VarChar(255)
  address              String?     @db.VarChar(500)
  postalCode           String?     @map("postal_code") @db.VarChar(6)
  latitude             Float?      @db.DoublePrecision
  longitude            Float?      @db.DoublePrecision
  locationProvider     String?     @map("location_provider") @db.VarChar(20)
  locationReference    String?     @map("location_reference") @db.VarChar(255)
  timezone             String      @default("UTC") @db.VarChar(100)
  startsAt             DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime    @map("ends_at") @db.Timestamptz(3)
  capacity             Int
  expectedAttendance   Int?        @map("expected_attendance")
  createIdempotencyKey String?     @map("create_idempotency_key") @db.VarChar(100)
  createPayloadHash    String?     @map("create_payload_hash") @db.Char(64)
  status               EventStatus @default(DRAFT)
  createdByUserId      String      @map("created_by_user_id") @db.Uuid
  cancelledByUserId    String?     @map("cancelled_by_user_id") @db.Uuid
  cancelledAt          DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason   String?     @map("cancellation_reason")
  version              Int         @default(1)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy           User                 @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy         User?                @relation("EventCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shifts              Shift[]
  stations            Station[]
  eventDays           EventDay[]
  registrations       EventRegistration[]
  staffAssignments    StaffAssignment[]
  auditLogs           EventAuditLog[]
  participantConsents ParticipantConsent[]

  @@unique([createdByUserId, createIdempotencyKey])
  @@index([status, startsAt])
  @@index([createdByUserId])
  @@map("events")
}

model EventDay {
  eventDayId String   @id @default(uuid()) @map("event_day_id") @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  date       DateTime @db.Date
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event                 Event                      @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  stationAvailabilities EventStationAvailability[]

  @@unique([eventId, date])
  @@index([eventId, startsAt])
  @@map("event_days")
}

model EventStationAvailability {
  eventStationAvailabilityId String    @id @default(uuid()) @map("event_station_availability_id") @db.Uuid
  eventStationId             String    @map("event_station_id") @db.Uuid
  eventDayId                 String    @map("event_day_id") @db.Uuid
  isAvailable                Boolean   @default(true) @map("is_available")
  startsAt                   DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt                     DateTime? @map("ends_at") @db.Timestamptz(3)
  capacity                   Int
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  eventDay EventDay @relation(fields: [eventDayId], references: [eventDayId], onDelete: Cascade)

  @@unique([eventStationId, eventDayId])
  @@index([eventDayId, isAvailable])
  @@map("event_station_availabilities")
}

model EventRegistration {
  registrationId         String                  @id @default(uuid()) @map("registration_id") @db.Uuid
  eventId                String                  @map("event_id") @db.Uuid
  participantId          String                  @map("participant_id") @db.Uuid
  registeredBy           String                  @map("registered_by") @db.Uuid
  registrationStatus     EventRegistrationStatus @default(SIGNED_UP) @map("registration_status")
  participantDisplayName String?                 @map("participant_display_name") @db.VarChar(150)
  queueNumber            Int?                    @map("queue_number")
  idempotencyKey         String                  @map("idempotency_key") @db.VarChar(100)
  passToken              String?                 @unique @map("pass_token") @db.VarChar(255)
  checkedIn              Boolean                 @default(false) @map("checked_in")
  checkedInAt            DateTime?               @map("checked_in_at") @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant      Participant                 @relation(fields: [participantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event            Event                       @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  registeredByUser User                        @relation("RegisteredBy", fields: [registeredBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qrCodePasses     QRCodePass[]
  queueEntries     QueueEntry[]
  queueMovements   QueueMovement[]
  scanLogs         ScanLog[]
  screeningResults ScreeningResult[]
  reviews          Review[]
  statusHistory    RegistrationStatusHistory[]
  consents         ParticipantConsent[]

  @@unique([participantId, eventId])
  @@unique([eventId, queueNumber])
  @@unique([registeredBy, idempotencyKey])
  @@index([eventId, registrationStatus, checkedIn])
  @@index([participantId])
  @@index([registeredBy])
  @@map("event_registrations")
}

model EventAuditLog {
  eventAuditLogId String           @id @default(uuid()) @map("event_audit_log_id") @db.Uuid
  eventId         String           @map("event_id") @db.Uuid
  actorUserId     String           @map("actor_user_id") @db.Uuid
  action          EventAuditAction
  beforeSnapshot  Json?            @map("before_snapshot")
  afterSnapshot   Json?            @map("after_snapshot")
  correlationId   String           @map("correlation_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  actor User  @relation("EventAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt, eventAuditLogId])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@map("event_audit_logs")
}

model Shift {
  shiftId       String      @id @default(uuid()) @map("shift_id") @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  name          String      @db.VarChar(100)
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(3)
  requiredStaff Int         @default(1) @map("required_staff")
  status        ShiftStatus @default(PLANNED)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event            Event             @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Cascade)
  staffAssignments StaffAssignment[]

  @@unique([eventId, name, startsAt])
  @@index([eventId, startsAt])
  @@map("shifts")
}

model Station {
  stationId    String      @id @default(uuid()) @map("station_id") @db.Uuid
  eventId      String      @map("event_id") @db.Uuid
  stationName  String      @map("station_name") @db.VarChar(100)
  stationType  StationType @map("station_type")
  stationOrder Int         @map("station_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event            Event             @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Cascade)
  staffAssignments StaffAssignment[]
  queueEntries     QueueEntry[]
  scanLogs         ScanLog[]
  screeningResults ScreeningResult[]
  fromMovements    QueueMovement[]   @relation("FromStation")
  toMovements      QueueMovement[]   @relation("ToStation")

  @@unique([eventId, stationType])
  @@unique([eventId, stationOrder])
  @@index([eventId, isActive, stationOrder])
  @@map("stations")
}

model StationTemplate {
  stationTemplateId String   @id @default(uuid()) @map("station_template_id") @db.Uuid
  templateKey       String   @unique @map("template_key") @db.VarChar(50)
  version           Int      @default(1)
  name              String   @db.VarChar(100)
  description       String?
  defaultCapacity   Int      @default(3) @map("default_capacity")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("station_templates")
}

model StaffAssignment {
  id               String                 @id @default(uuid()) @map("assignment_id") @db.Uuid
  eventId          String                 @map("event_id") @db.Uuid
  stationId        String?                @map("station_id") @db.Uuid
  shiftId          String?                @map("shift_id") @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  assignedBy       String                 @map("assigned_by") @db.Uuid
  assignmentRole   StaffAssignmentRole?   @map("assignment_role")
  assignedAt       DateTime               @default(now()) @map("assigned_at")
  assignmentStatus StaffAssignmentStatus  @default(ASSIGNED) @map("assignment_status")
  status           StaffAssignmentStatus? @default(ASSIGNED)
  notes            String?

  event        Event    @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Cascade)
  station      Station? @relation(fields: [stationId], references: [stationId], onDelete: SetNull, onUpdate: Cascade)
  shift        Shift?   @relation(fields: [shiftId], references: [shiftId], onDelete: Cascade, onUpdate: Cascade)
  assignedUser User     @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assigner     User     @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([eventId, userId, shiftId, stationId])
  @@index([eventId, assignmentStatus])
  @@index([userId, assignmentStatus])
  @@map("staff_assignments")
}

model QueueEntry {
  id             String      @id @default(uuid()) @map("queue_id") @db.Uuid
  registrationId String      @map("registration_id") @db.Uuid
  stationId      String      @map("station_id") @db.Uuid
  queueNumber    Int         @map("queue_number")
  status         QueueStatus @default(WAITING)
  enteredAt      DateTime    @default(now()) @map("entered_at")
  calledAt       DateTime?   @map("called_at")
  startedAt      DateTime?   @map("started_at")
  leftQueueAt    DateTime?   @map("left_queue_at")
  completedAt    DateTime?   @map("completed_at")

  registration     EventRegistration @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade, onUpdate: Cascade)
  station          Station           @relation(fields: [stationId], references: [stationId], onDelete: Cascade, onUpdate: Cascade)
  screeningResults ScreeningResult[]

  @@index([stationId, status, queueNumber])
  @@index([registrationId, status])
  @@map("queue_entries")
}

model QueueMovement {
  id             String   @id @default(uuid()) @map("movement_id") @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  fromStationId  String   @map("from_station_id") @db.Uuid
  toStationId    String   @map("to_station_id") @db.Uuid
  movedBy        String   @map("moved_by") @db.Uuid
  movementReason String   @map("movement_reason") @db.VarChar(100)
  movementTime   DateTime @default(now()) @map("movement_time")

  registration EventRegistration @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade, onUpdate: Cascade)
  fromStation  Station           @relation("FromStation", fields: [fromStationId], references: [stationId], onDelete: Restrict, onUpdate: Cascade)
  toStation    Station           @relation("ToStation", fields: [toStationId], references: [stationId], onDelete: Restrict, onUpdate: Cascade)
  movedByUser  User              @relation("MovedBy", fields: [movedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([registrationId])
  @@index([movedBy])
  @@map("queue_movements")
}

model ScanLog {
  id             String     @id @default(uuid()) @map("scan_id") @db.Uuid
  qrId           String?    @map("qr_id") @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  stationId      String     @map("station_id") @db.Uuid
  scanResult     ScanResult @map("scan_result")
  deviceName     String     @map("device_name") @db.VarChar(100)
  ipAddress      String     @map("ip_address") @db.VarChar(45)
  scannedAt      DateTime   @default(now()) @map("scanned_at")
  registrationId String?    @map("registration_id") @db.Uuid

  qrCode       QRCodePass?        @relation(fields: [qrId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  station      Station            @relation(fields: [stationId], references: [stationId], onDelete: Cascade, onUpdate: Cascade)
  registration EventRegistration? @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade, onUpdate: Cascade)

  @@index([stationId, scannedAt])
  @@index([qrId])
  @@index([registrationId])
  @@map("scan_logs")
}

model QRCodePass {
  id             String    @id @default(uuid()) @map("qr_id") @db.Uuid
  registrationId String    @map("registration_id") @db.Uuid
  token          String    @unique @db.VarChar(200)
  tokenHash      String?   @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  isActive       Boolean   @default(true) @map("is_active")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  revokedReason  String?   @map("revoked_reason") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  registration EventRegistration @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade, onUpdate: Cascade)
  revokedUser  User?             @relation(fields: [revokedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scanLogs     ScanLog[]

  @@index([registrationId, isActive])
  @@map("qr_code_passes")
}

// ==========================================
// SCREENING, REVIEWS & REFERRALS
// ==========================================

model ScreeningResult {
  resultId         String      @id @default(uuid()) @map("result_id") @db.Uuid
  registrationId   String      @map("registration_id") @db.Uuid
  stationId        String      @map("station_id") @db.Uuid
  recordedByUserId String      @map("recorded_by_user_id") @db.Uuid
  queueEntryId     String?     @map("queue_entry_id") @db.Uuid
  screeningType    StationType @map("screening_type")
  resultData       Json        @map("result_data")
  overallFlag      OverallFlag @default(NORMAL) @map("overall_flag")
  isFlagged        Boolean     @default(false) @map("is_flagged")
  flagSummary      String?     @map("flag_summary")
  ruleVersion      String      @default("VSMS-VA-1.0") @map("rule_version") @db.VarChar(20)
  acknowledgedAt   DateTime?   @map("acknowledged_at") @db.Timestamptz(3)
  idempotencyKey   String      @unique @map("idempotency_key") @db.VarChar(64)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  registration EventRegistration @relation(fields: [registrationId], references: [registrationId], onDelete: Restrict, onUpdate: Cascade)
  station      Station           @relation(fields: [stationId], references: [stationId], onDelete: Restrict, onUpdate: Cascade)
  queueEntry   QueueEntry?       @relation(fields: [queueEntryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recordedBy   User              @relation("ScreeningRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([registrationId, stationId])
  @@index([stationId, isFlagged])
  @@index([overallFlag, isFlagged])
  @@index([recordedByUserId])
  @@map("screening_results")
}

model Review {
  reviewId         String          @id @default(uuid()) @map("review_id") @db.Uuid
  registrationId   String          @map("registration_id") @db.Uuid
  version          Int             @default(1)
  reviewedByUserId String          @map("reviewed_by_user_id") @db.Uuid
  parentReviewId   String?         @map("parent_review_id") @db.Uuid
  outcome          ReviewOutcome
  urgency          ClinicalUrgency
  clinicalSummary  String          @map("clinical_summary")
  recommendations  String?
  reviewedAt       DateTime        @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  registration EventRegistration  @relation(fields: [registrationId], references: [registrationId], onDelete: Restrict, onUpdate: Cascade)
  reviewer     User               @relation("ReviewReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentReview Review?            @relation("ReviewHierarchy", fields: [parentReviewId], references: [reviewId], onDelete: Restrict, onUpdate: Cascade)
  childReviews Review[]           @relation("ReviewHierarchy")
  referrals    Referral[]
  documents    DocumentArtifact[]

  @@unique([registrationId, version])
  @@index([registrationId, reviewedAt])
  @@index([reviewedByUserId])
  @@index([outcome, urgency])
  @@map("reviews")
}

model Referral {
  referralId       String          @id @default(uuid()) @map("referral_id") @db.Uuid
  reviewId         String          @map("review_id") @db.Uuid
  registrationId   String          @map("registration_id") @db.Uuid
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  destinationName  String          @map("destination_name") @db.VarChar(200)
  destinationEmail String?         @map("destination_email") @db.VarChar(255)
  reason           String
  instructions     String?
  urgency          ClinicalUrgency
  status           ReferralStatus  @default(DRAFT)
  referredAt       DateTime?       @map("referred_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  review                 Review                 @relation(fields: [reviewId], references: [reviewId], onDelete: Restrict, onUpdate: Cascade)
  creator                User                   @relation("ReferralCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentArtifacts      DocumentArtifact[]
  notificationDeliveries NotificationDelivery[]

  @@index([registrationId, createdAt])
  @@index([reviewId])
  @@index([createdByUserId])
  @@index([status, urgency])
  @@map("referrals")
}

model DocumentArtifact {
  documentId        String       @id @default(uuid()) @map("document_id") @db.Uuid
  reviewId          String       @map("review_id") @db.Uuid
  referralId        String?      @map("referral_id") @db.Uuid
  documentType      DocumentType @map("document_type")
  version           Int          @default(1)
  storageKey        String       @map("storage_key")
  contentHash       String       @map("content_hash") @db.Char(64)
  mimeType          String       @map("mime_type") @db.VarChar(100)
  sizeBytes         BigInt       @map("size_bytes")
  generatedByUserId String       @map("generated_by_user_id") @db.Uuid
  generatedAt       DateTime     @default(now()) @map("generated_at") @db.Timestamptz(3)

  review      Review    @relation(fields: [reviewId], references: [reviewId], onDelete: Restrict, onUpdate: Cascade)
  referral    Referral? @relation(fields: [referralId], references: [referralId], onDelete: SetNull, onUpdate: Cascade)
  generatedBy User      @relation("DocumentGenerator", fields: [generatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([reviewId])
  @@index([referralId])
  @@map("document_artifacts")
}

// ==========================================
// SYSTEM AUDIT & LOGGING
// ==========================================

model AuditLog {
  id         String      @id @default(uuid()) @map("audit_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  deviceId   String?     @map("device_id") @db.Uuid
  action     String      @db.VarChar(100)
  resource   String?     @db.VarChar(100)
  entityName String?     @map("entity_name") @db.VarChar(50)
  entityId   String?     @map("entity_id") @db.Uuid
  outcome    AuthOutcome @default(SUCCESS)
  requestId  String?     @map("request_id") @db.Uuid
  details    Json?
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  deviceName String?     @map("device_name") @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([requestId])
  @@index([deviceId, createdAt])
  @@index([entityName, entityId])
  @@map("audit_logs")
}

model LoginHistory {
  id        String   @id @default(uuid()) @map("login_history_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  success   Boolean
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@map("login_history")
}

model SecurityIncident {
  id          String           @id @default(uuid()) @map("incident_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  severity    IncidentSeverity @default(MEDIUM)
  description String
  resolved    Boolean          @default(false)
  resolvedBy  String?          @map("resolved_by") @db.Uuid
  resolvedAt  DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User? @relation("IncidentUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolver User? @relation("ResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("security_incidents")
}

model NotificationDelivery {
  id            String                     @id @default(uuid()) @map("notification_id") @db.Uuid
  userId        String?                    @map("user_id") @db.Uuid
  referralId    String?                    @map("referral_id") @db.Uuid
  channel       NotificationChannel        @default(EMAIL)
  status        NotificationDeliveryStatus @default(QUEUED)
  recipient     String                     @db.VarChar(255)
  subject       String                     @db.VarChar(255)
  body          String
  failureReason String?                    @map("failure_reason")
  sentAt        DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  referral Referral? @relation(fields: [referralId], references: [referralId], onDelete: SetNull, onUpdate: Cascade)

  @@map("notification_deliveries")
}

model SyncAction {
  id         String           @id @default(uuid()) @map("sync_action_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  operation  SyncOperation
  entityType String           @map("entity_type") @db.VarChar(50)
  entityId   String           @map("entity_id") @db.Uuid
  payload    Json
  status     SyncActionStatus @default(PENDING)
  retryCount Int              @default(0) @map("retry_count")
  errorLog   String?          @map("error_log")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation("SyncActor", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("sync_actions")
}

model AuthAuditLog {
  id              String      @id @default(uuid()) @map("auth_log_id") @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  deviceId        String?     @map("device_id") @db.Uuid
  eventType       String      @map("event_type") @db.VarChar(50)
  outcome         AuthOutcome
  failureCategory String?     @map("failure_category") @db.VarChar(50)
  identifierHash  String?     @map("identifier_hash") @db.Char(64)
  ipAddress       String?     @map("ip_address") @db.VarChar(45)
  userAgent       String?     @map("user_agent") @db.VarChar(500)
  requestId       String?     @map("request_id") @db.Uuid
  occurredAt      DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([requestId])
  @@index([deviceId, occurredAt])
  @@map("auth_audit_logs")
}

model Device {
  id              String    @id @default(uuid()) @map("device_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  deviceName      String    @map("device_name") @db.VarChar(100)
  fingerprintHash String?   @map("fingerprint_hash") @db.Char(64)
  status          String    @default("ACTIVE") @db.VarChar(20)
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  authLogs  AuthAuditLog[]
  auditLogs AuditLog[]
  consents  ParticipantConsent[]

  @@index([userId, status])
  @@map("devices")
}

model ParticipantEmergencyContact {
  id            String                 @id @default(uuid()) @map("emergency_contact_id") @db.Uuid
  participantId String                 @map("participant_id") @db.Uuid
  contactName   String                 @map("contact_name") @db.VarChar(120)
  relationship  String                 @db.VarChar(60)
  phoneNumber   String                 @map("phone_number") @db.VarChar(30)
  email         String?                @db.VarChar(255)
  isPrimary     Boolean                @default(false) @map("is_primary")
  status        EmergencyContactStatus @default(ACTIVE)
  createdById   String                 @map("created_by") @db.Uuid
  updatedById   String                 @map("updated_by") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("EmergencyContactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User        @relation("EmergencyContactUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([participantId])
  @@index([createdById])
  @@index([updatedById])
  @@index([participantId, isPrimary, status])
  @@map("participant_emergency_contacts")
}

model ConsentFormVersion {
  id                String    @id @default(uuid()) @map("consent_form_version_id") @db.Uuid
  formCode          String    @map("form_code") @db.VarChar(50)
  versionNumber     String    @map("version_number") @db.VarChar(30)
  title             String    @db.VarChar(200)
  contentText       String?   @map("content_text") @db.Text
  contentHash       String    @map("content_hash") @db.Char(64)
  documentObjectKey String    @map("document_object_key") @db.VarChar(500)
  effectiveFrom     DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(3)
  isActive          Boolean   @default(true) @map("is_active")
  createdById       String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User                 @relation("ConsentFormVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  consents  ParticipantConsent[]

  @@unique([formCode, versionNumber])
  @@index([isActive, effectiveFrom])
  @@index([createdById])
  @@map("consent_form_versions")
}

model ParticipantConsent {
  id                   String        @id @default(uuid()) @map("consent_id") @db.Uuid
  participantId        String        @map("participant_id") @db.Uuid
  eventId              String        @map("event_id") @db.Uuid
  registrationId       String?       @map("registration_id") @db.Uuid
  withdrawalOfId       String?       @map("withdrawal_of_id") @db.Uuid
  consentFormVersionId String        @map("consent_form_version_id") @db.Uuid
  consentStatus        ConsentStatus @default(PENDING) @map("consent_status")
  signerType           String?       @map("signer_type") @db.VarChar(40)
  signerName           String?       @map("signer_name") @db.VarChar(150)
  signerRelationship   String?       @map("signer_relationship") @db.VarChar(60)
  guardianContactName  String?       @map("guardian_contact_name") @db.VarChar(150)
  guardianContactPhone String?       @map("guardian_contact_phone") @db.VarChar(30)
  guardianContactEmail String?       @map("guardian_contact_email") @db.VarChar(255)
  signatureObjectKey   String?       @map("signature_object_key") @db.VarChar(500)
  signatureSha256      String?       @map("signature_sha256") @db.Char(64)
  signatureMimeType    String?       @map("signature_mime_type") @db.VarChar(100)
  deviceId             String?       @map("device_id") @db.Uuid
  recordedById         String        @map("recorded_by") @db.Uuid
  signedAt             DateTime?     @map("signed_at") @db.Timestamptz(3)
  withdrawnAt          DateTime?     @map("withdrawn_at") @db.Timestamptz(3)
  decisionAt           DateTime?     @map("decision_at") @db.Timestamptz(3)
  withdrawalReason     String?       @map("withdrawal_reason") @db.Text
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  participant        Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  event              Event                @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  registration       EventRegistration?   @relation(fields: [registrationId], references: [registrationId], onDelete: SetNull)
  withdrawalOf       ParticipantConsent?  @relation("ConsentWithdrawal", fields: [withdrawalOfId], references: [id], onDelete: Restrict)
  withdrawals        ParticipantConsent[] @relation("ConsentWithdrawal")
  consentFormVersion ConsentFormVersion   @relation(fields: [consentFormVersionId], references: [id], onDelete: Restrict)
  recordedBy         User                 @relation("ConsentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  device             Device?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@index([eventId])
  @@index([registrationId])
  @@index([withdrawalOfId])
  @@index([consentFormVersionId])
  @@index([recordedById])
  @@index([deviceId])
  @@map("participant_consents")
}

model RegistrationStatusHistory {
  id             String                   @id @default(uuid()) @map("history_id") @db.Uuid
  registrationId String                   @map("registration_id") @db.Uuid
  fromStatus     EventRegistrationStatus? @map("from_status")
  toStatus       EventRegistrationStatus  @map("to_status")
  changedById    String                   @map("changed_by") @db.Uuid
  reason         String?                  @db.VarChar(200)
  occurredAt     DateTime                 @default(now()) @map("occurred_at") @db.Timestamptz(3)

  registration EventRegistration @relation(fields: [registrationId], references: [registrationId], onDelete: Restrict)
  changedBy    User              @relation("RegistrationStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([registrationId, occurredAt])
  @@index([changedById])
  @@map("registration_status_history")
}
