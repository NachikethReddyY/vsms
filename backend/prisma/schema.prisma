generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum ScanResult {
  SUCCESS
  INVALID
  EXPIRED
  REVOKED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  UPCOMING
  ONGOING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StaffAssignmentRole {
  EVENT_MANAGER
  REGISTRATION
  SCREENER
  REVIEWER
  SUPPORT
}

enum StaffAssignmentStatus {
  ASSIGNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  SIGNED_UP
  REGISTERED
  CHECKED_IN
  CANCELLED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Outcome {
  PASSED
  FAILED
  PENDING
  REFERRED
}

enum DocType {
  PDF
  IMAGE
  REPORT
  SUMMARY
  REFERRAL_PDF
  CLINICAL_SUMMARY_PDF
}

enum Channel {
  EMAIL
  SMS
  IN_APP
}

enum StationType {
  VISUAL_ACUITY
  REFRACTION
  COLOUR_VISION
  EYE_HEALTH
}

enum OverallFlag {
  NORMAL
  REVIEW
  REFER
  URGENT
}

enum ReviewOutcome {
  COMPLETE
  MONITOR
  REFER
  URGENT_ESCALATION
}

enum ClinicalUrgency {
  ROUTINE
  PRIORITY
  URGENT
  EMERGENCY
}

enum ReferralStatus {
  DRAFT
  ISSUED
  SENT
  ACKNOWLEDGED
  CANCELLED
}

enum NotificationDeliveryStatus {
  QUEUED
  SENDING
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncActionStatus {
  PENDING
  PROCESSING
  APPLIED
  CONFLICT
  FAILED
}

// ==========================================
// AUTHENTICATION & USER MANAGEMENT
// ==========================================

model User {
  id                  String     @id @default(uuid()) @map("user_id") @db.Uuid
  fullName            String     @map("full_name") @db.VarChar(100)
  email               String     @unique @db.VarChar(255)
  contactNumber       String?    @map("contact_number") @db.VarChar(20)
  emergencyContact    String?    @map("emergency_contact") @db.VarChar(20)
  dateOfBirth         DateTime?  @map("date_of_birth") @db.Date
  gender              String?    @db.VarChar(1)
  employeeNumber      String     @unique @map("employee_number") @db.VarChar(20)
  department          String?    @db.VarChar(100)
  designation         String?    @db.VarChar(100)
  status              UserStatus @default(ACTIVE)
  consentConfirmation Boolean    @default(false) @map("consent_confirmation")
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  // Relations
  credential             UserCredential?
  userRoles              UserRole[]
  staffAssignments       StaffAssignment[]      @relation("AssignedUser")
  assignedStaff          StaffAssignment[]      @relation("AssignedBy")
  eventRegistrations     EventRegistration[]    @relation("RegisteredBy")
  revokedQRCodes         QRCodePass[]
  scanLogs               ScanLog[]
  auditLogs              AuditLog[]
  loginHistories         LoginHistory[]
  securityIncidents      SecurityIncident[]     @relation("IncidentUser")
  resolvedIncidents      SecurityIncident[]     @relation("ResolvedBy")
  reviews                Review[]               @relation("ReviewReviewer")
  referrals              Referral[]             @relation("ReferralCreator")
  documentArtifacts      DocumentArtifact[]     @relation("DocumentGenerator")
  syncActions            SyncAction[]           @relation("SyncActor")
  screeningResults       ScreeningResult[]      @relation("ScreeningRecorder")
  movedQueueEntries      QueueMovement[]        @relation("MovedBy")
  notificationDeliveries NotificationDelivery[]
  eventsCreated          Event[]                @relation("EventCreatedBy")
  eventsCancelled        Event[]                @relation("EventCancelledBy")

  @@index([status, department])
  @@index([email])
  @@map("user")
}

model UserCredential {
  id           String   @id @default(uuid()) @map("credential_id") @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credential")
}

model UserRole {
  id     String @id @default(uuid()) @map("role_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role   String @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role])
  @@map("user_role")
}

// ==========================================
// PARTICIPANT & EVENT MANAGEMENT
// ==========================================

model Participant {
  id                   String   @id @default(uuid()) @map("participant_id") @db.Uuid
  nric                 String   @unique @db.Text
  nricMasked           String   @map("nric_masked") @db.VarChar(9)
  firstName            String   @map("first_name") @db.VarChar(100)
  lastName             String   @map("last_name") @db.VarChar(100)
  dateOfBirth          DateTime @map("date_of_birth") @db.Date
  gender               String   @db.VarChar(1)
  race                 String?  @db.VarChar(50)
  nationality          String?  @default("Singaporean") @db.VarChar(50)
  address              String?  @db.Text
  contactNumber        String   @map("contact_number") @db.VarChar(20)
  emergencyContact     String   @map("emergency_contact") @db.VarChar(20)
  emergencyContactName String?  @map("emergency_contact_name") @db.VarChar(100)
  consentGiven         Boolean  @map("consent_given")
  version              Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  eventRegistrations EventRegistration[]

  @@index([lastName, firstName])
  @@index([contactNumber])
  @@map("participant")
}

model Event {
  id                 String      @id @default(uuid()) @map("event_id") @db.Uuid
  name               String      @map("event_name") @db.VarChar(150)
  description        String?
  bannerKey          String      @default("COMMUNITY_SCREENING") @map("banner_key") @db.VarChar(50)
  artworkDataUrl     String?     @map("artwork_data_url")
  venue              String      @db.VarChar(255)
  timezone           String      @default("UTC") @db.VarChar(100)
  startsAt           DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime    @map("ends_at") @db.Timestamptz(3)
  capacity           Int         @default(100)
  status             EventStatus @default(DRAFT)
  createdByUserId    String      @map("created_by_user_id") @db.Uuid
  cancelledByUserId  String?     @map("cancelled_by_user_id") @db.Uuid
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?     @map("cancellation_reason")
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy        User                @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy      User?               @relation("EventCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  shifts           Shift[]
  stations         Station[]
  registrations    EventRegistration[]
  staffAssignments StaffAssignment[]

  @@index([status, startsAt, endsAt])
  @@index([createdByUserId])
  @@map("events")
}

model Shift {
  id            String      @id @default(uuid()) @map("shift_id") @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  name          String      @db.VarChar(100)
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(3)
  requiredStaff Int         @default(1) @map("required_staff")
  status        ShiftStatus @default(PLANNED)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffAssignments StaffAssignment[]

  @@unique([eventId, name, startsAt])
  @@index([eventId, status, startsAt])
  @@map("shift")
}

model EventRegistration {
  id                     String             @id @default(uuid()) @map("registration_id") @db.Uuid
  participantId          String             @map("participant_id") @db.Uuid
  eventId                String             @map("event_id") @db.Uuid
  queueNumber            Int?               @map("queue_number")
  registrationStatus     RegistrationStatus @default(SIGNED_UP) @map("registration_status")
  participantDisplayName String?            @map("participant_display_name") @db.VarChar(150)
  passToken              String?            @unique @map("pass_token") @db.VarChar(255)
  registeredBy           String             @map("registered_by") @db.Uuid
  registeredAt           DateTime           @default(now()) @map("registered_at")
  checkedIn              Boolean            @default(false) @map("checked_in")
  checkedInAt            DateTime?          @map("checked_in_at")
  version                Int                @default(1)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant      Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registeredByUser User              @relation("RegisteredBy", fields: [registeredBy], references: [id], onDelete: Restrict)
  qrCodePasses     QRCodePass[]
  queueEntries     QueueEntry[]
  queueMovements   QueueMovement[]
  scanLogs         ScanLog[]
  screeningResults ScreeningResult[]
  reviews          Review[]
  referrals        Referral[]

  @@unique([eventId, participantId])
  @@index([eventId, registrationStatus, checkedIn])
  @@index([participantId])
  @@index([registeredBy])
  @@map("event_registrations")
}

model QRCodePass {
  id             String    @id @default(uuid()) @map("qr_id") @db.Uuid
  registrationId String    @map("registration_id") @db.Uuid
  token          String    @unique @map("token") @db.VarChar(255)
  issuedAt       DateTime  @default(now()) @map("issue_at")
  expiresAt      DateTime  @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  revokedAt      DateTime? @map("revoked_at")
  revokedBy      String?   @map("revoked_by") @db.Uuid
  revokedReason  String?   @map("revoked_reason") @db.VarChar(255)

  registration  EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  revokedByUser User?             @relation(fields: [revokedBy], references: [id], onDelete: SetNull)
  scanLogs      ScanLog[]

  @@index([registrationId, isActive])
  @@index([expiresAt])
  @@map("qr_code_pass")
}

// ==========================================
// STATIONS & QUEUE OPERATIONS
// ==========================================

model Station {
  id           String      @id @default(uuid()) @map("station_id") @db.Uuid
  eventId      String      @map("event_id") @db.Uuid
  stationName  String      @map("station_name") @db.VarChar(100)
  stationType  StationType @map("station_type")
  stationOrder Int         @map("station_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffAssignments StaffAssignment[]
  queueEntries     QueueEntry[]
  scanLogs         ScanLog[]
  screeningResults ScreeningResult[]
  fromMovements    QueueMovement[]   @relation("FromStation")
  toMovements      QueueMovement[]   @relation("ToStation")

  @@unique([eventId, stationType])
  @@unique([eventId, stationOrder])
  @@index([eventId, isActive, stationOrder])
  @@map("station")
}

model StaffAssignment {
  id               String                 @id @default(uuid()) @map("assignment_id") @db.Uuid
  eventId          String                 @map("event_id") @db.Uuid
  stationId        String?                @map("station_id") @db.Uuid
  shiftId          String?                @map("shift_id") @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  assignedBy       String                 @map("assigned_by") @db.Uuid
  assignmentRole   StaffAssignmentRole?   @map("assignment_role")
  assignedAt       DateTime               @default(now()) @map("assigned_at")
  assignmentStatus AssignmentStatus       @default(ACTIVE) @map("assignment_status")
  status           StaffAssignmentStatus? @default(ASSIGNED)
  notes            String?

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  station      Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  shift        Shift?   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  assignedUser User     @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner     User     @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([eventId, assignmentStatus])
  @@index([userId, assignmentStatus])
  @@index([stationId])
  @@index([shiftId])
  @@map("staff_assignment")
}

model QueueEntry {
  id             String      @id @default(uuid()) @map("queue_id") @db.Uuid
  registrationId String      @map("registration_id") @db.Uuid
  stationId      String      @map("station_id") @db.Uuid
  queueNumber    Int         @map("queue_number")
  status         QueueStatus @default(WAITING)
  enteredAt      DateTime    @default(now()) @map("entered_at")
  calledAt       DateTime?   @map("called_at")
  startedAt      DateTime?   @map("started_at")
  leftQueueAt    DateTime?   @map("left_queue_at")
  completedAt    DateTime?   @map("completed_at")

  registration     EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  station          Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  screeningResults ScreeningResult[]

  @@index([stationId, status, queueNumber])
  @@index([registrationId, status])
  @@map("queue_entry")
}

model QueueMovement {
  id             String   @id @default(uuid()) @map("movement_id") @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  fromStationId  String   @map("from_station_id") @db.Uuid
  toStationId    String   @map("to_station_id") @db.Uuid
  movedBy        String   @map("moved_by") @db.Uuid
  movementReason String   @map("movement_reason") @db.VarChar(100)
  movementTime   DateTime @default(now()) @map("movement_time")

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStation  Station           @relation("FromStation", fields: [fromStationId], references: [id], onDelete: Restrict)
  toStation    Station           @relation("ToStation", fields: [toStationId], references: [id], onDelete: Restrict)
  movedByUser  User              @relation("MovedBy", fields: [movedBy], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([movedBy])
  @@map("queue_movement")
}

model ScanLog {
  id             String     @id @default(uuid()) @map("scan_id") @db.Uuid
  qrId           String?    @map("qr_id") @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  stationId      String     @map("station_id") @db.Uuid
  scanResult     ScanResult @map("scan_result")
  deviceName     String     @map("device_name") @db.VarChar(100)
  ipAddress      String     @map("ip_address") @db.VarChar(45)
  scannedAt      DateTime   @default(now()) @map("scanned_at")
  registrationId String?    @map("registration_id") @db.Uuid

  qrCode       QRCodePass?        @relation(fields: [qrId], references: [id], onDelete: SetNull)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  station      Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  registration EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([stationId, scannedAt])
  @@index([qrId])
  @@index([registrationId])
  @@map("scan_log")
}

// ==========================================
// SCREENING, REVIEWS & REFERRALS
// ==========================================

model ScreeningResult {
  id               String      @id @default(uuid()) @map("result_id") @db.Uuid
  registrationId   String      @map("registration_id") @db.Uuid
  stationId        String      @map("station_id") @db.Uuid
  queueEntryId     String?     @map("queue_entry_id") @db.Uuid
  recordedByUserId String      @map("recorded_by_user_id") @db.Uuid
  screeningType    StationType @map("screening_type")
  resultData       Json        @map("result_data")
  overallFlag      OverallFlag @default(NORMAL) @map("overall_flag")
  isFlagged        Boolean     @default(false) @map("is_flagged")
  flagSummary      String?     @map("flag_summary")
  ruleVersion      String      @default("VSMS-VA-1.0") @map("rule_version") @db.VarChar(20)
  acknowledgedAt   DateTime?   @map("acknowledged_at") @db.Timestamptz(3)
  idempotencyKey   String?     @unique @map("idempotency_key") @db.VarChar(64)
  version          Int         @default(1)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  station      Station           @relation(fields: [stationId], references: [id], onDelete: Restrict)
  queueEntry   QueueEntry?       @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  recordedBy   User              @relation("ScreeningRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([registrationId, stationId])
  @@index([stationId, isFlagged])
  @@index([overallFlag, isFlagged])
  @@index([recordedByUserId])
  @@map("screening_results")
}

model Review {
  id              String           @id @default(uuid()) @map("review_id") @db.Uuid
  registrationId  String?          @map("registration_id") @db.Uuid
  reviewerId      String           @map("reviewer_id") @db.Uuid
  outcome         Outcome?
  reviewOutcome   ReviewOutcome?
  urgency         Urgency?
  clinicalUrgency ClinicalUrgency? @default(ROUTINE)
  clinicalSummary String           @map("clinical_summary") @db.Text
  recommendations String?          @db.Text
  reviewDatetime  DateTime?        @map("review_datetime")
  version         Int              @default(1)
  parentReviewId  String?          @map("previous_review_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  registration EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reviewer     User               @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  parentReview Review?            @relation("ReviewHierarchy", fields: [parentReviewId], references: [id], onDelete: Restrict)
  childReviews Review[]           @relation("ReviewHierarchy")
  referrals    Referral[]
  documents    DocumentArtifact[]

  @@index([registrationId])
  @@index([reviewerId])
  @@index([clinicalUrgency])
  @@map("review")
}

model Referral {
  id               String           @id @default(uuid()) @map("referral_id") @db.Uuid
  reviewId         String           @map("review_id") @db.Uuid
  registrationId   String?          @map("registration_id") @db.Uuid
  createdBy        String           @map("created_by") @db.Uuid
  destination      String           @db.VarChar(255)
  destinationEmail String?          @map("destination_email") @db.VarChar(255)
  reason           String           @db.Text
  instructions     String?          @db.Text
  urgency          Urgency?
  clinicalUrgency  ClinicalUrgency?
  status           ReferralStatus   @default(DRAFT)
  referralDatetime DateTime?        @map("referral_datetime")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  review                 Review                 @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  registration           EventRegistration?     @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  creator                User                   @relation("ReferralCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  documentArtifacts      DocumentArtifact[]
  notificationDeliveries NotificationDelivery[]

  @@index([reviewId])
  @@index([status, clinicalUrgency])
  @@index([createdBy])
  @@map("referral")
}

model DocumentArtifact {
  id           String    @id @default(uuid()) @map("document_id") @db.Uuid
  reviewId     String?   @map("review_id") @db.Uuid
  referralId   String?   @map("referral_id") @db.Uuid
  documentType DocType   @map("document_type")
  version      Int       @default(1)
  storageKey   String    @map("storage_key") @db.VarChar(500)
  fileHash     String    @map("file_hash") @db.Char(64)
  fileName     String?   @map("file_name") @db.VarChar(100)
  fileSize     BigInt    @map("file_size")
  generatedBy  String    @map("generated_by") @db.Uuid
  generatedAt  DateTime  @default(now()) @map("generated_at")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)

  review                 Review?                @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  referral               Referral?              @relation(fields: [referralId], references: [id], onDelete: SetNull)
  generator              User                   @relation("DocumentGenerator", fields: [generatedBy], references: [id], onDelete: Restrict)
  notificationDeliveries NotificationDelivery[]

  @@index([reviewId])
  @@index([referralId])
  @@index([generatedBy])
  @@map("document_artifact")
}

model NotificationDelivery {
  id                        String                     @id @default(uuid()) @map("notification_id") @db.Uuid
  userId                    String                     @map("user_id") @db.Uuid
  referralId                String?                    @map("referral_id") @db.Uuid
  documentId                String?                    @map("document_id") @db.Uuid
  channel                   Channel                    @default(EMAIL)
  recipient                 Bytes?
  recipientAddressEncrypted Bytes?                     @map("recipient_address_encrypted")
  templateId                String?                    @map("template_id") @db.Uuid
  templateKey               String?                    @map("template_key") @db.VarChar(100)
  status                    NotificationDeliveryStatus @default(QUEUED)
  attempts                  Int                        @default(0)
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referral Referral?         @relation(fields: [referralId], references: [id], onDelete: SetNull)
  document DocumentArtifact? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([status, channel])
  @@index([userId])
  @@map("notification_delivery")
}

// ==========================================
// SYSTEM AUDITING & SYNC
// ==========================================

model SyncAction {
  id             String           @id @default(uuid()) @map("sync_action_id") @db.Uuid
  deviceId       String           @map("device_id") @db.VarChar(255)
  userId         String           @map("user_id") @db.Uuid
  registrationId String?          @map("registration_id") @db.Uuid
  entityType     String           @map("entity_type") @db.VarChar(100)
  entityId       String           @map("entity_id") @db.Uuid
  operation      SyncOperation?
  baseVersion    Int?             @map("base_version")
  payload        Json             @db.JsonB
  status         SyncActionStatus @default(PENDING)
  attempts       Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at")
  processedAt    DateTime?        @map("processed_at")

  user User @relation("SyncActor", fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([deviceId, userId])
  @@map("sync_action")
}

model LoginHistory {
  id          String    @id @default(uuid()) @map("login_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  loginTime   DateTime  @default(now()) @map("login_time")
  logoutTime  DateTime? @map("logout_time")
  loginStatus String    @map("login_status")
  ipAddress   String    @map("ip_address") @db.VarChar(45)
  deviceName  String    @map("device_name") @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginTime])
  @@map("login_history")
}

model AuditLog {
  id         String   @id @default(uuid()) @map("audit_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityName String   @map("entity_name") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String   @map("ip_address") @db.VarChar(45)
  deviceName String   @map("device_name") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityName, entityId])
  @@index([userId, createdAt])
  @@map("audit_log")
}

model SecurityIncident {
  id           String    @id @default(uuid()) @map("incident_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  incidentType String    @map("incident_type") @db.VarChar(100)
  severity     String
  description  String    @db.Text
  resolved     Boolean   @default(false)
  resolvedBy   String?   @map("resolved_by") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user     User  @relation("IncidentUser", fields: [userId], references: [id], onDelete: Restrict)
  resolver User? @relation("ResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([resolved, severity])
  @@index([userId])
  @@map("security_incident")
}
