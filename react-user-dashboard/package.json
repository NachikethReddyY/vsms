{
  "name": "react-user-dashboard",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "pnpm run test:participants && pnpm run test:queue && pnpm run test:audit && pnpm run test:qr && pnpm run test:shell && pnpm run test:stage4 && pnpm run test:offline && vitest run src/features/events/eventDisplayStatus.test.mjs src/features/screening/qrHandoff.test.ts src/features/screening/startQrScanner.test.ts src/features/screening/scannerControls.test.ts src/features/reviews/referralRecovery.test.ts src/utils/logout.test.ts",
    "test:participants": "node --test src/pages/participant/ParticipantPage.test.mjs",
    "test:queue": "node --test src/pages/QueuePages.test.mjs",
    "test:audit": "node --test src/pages/admin/SystemAuditDashboardPage.test.mjs",
    "test:qr": "node --test src/components/qr/QRCodePage.test.mjs",
    "test:shell": "node --test src/components/AppShell.navigation.test.mjs",
    "test:stage4": "vitest run src/components/LandingPage.test.tsx src/auth/CognitoRoutes.test.tsx src/features/stage4Api.test.ts src/features/Stage4Pages.behavior.test.tsx src/App.routing.test.tsx src/pages/StationLibraryPage.test.tsx",
    "test:offline": "vitest run src/features/screening/offlineSync.test.ts src/features/screening/screeningApi.offline.test.ts src/features/screening/RouteProgressionNotice.test.ts src/features/screening/EyeHealthStationPage.test.tsx src/features/screening/fieldSchema.compatibility.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.7",
    "@astryxdesign/theme-neutral": "^0.1.7",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "axios": "^1.18.1",
    "html5-qrcode": "^2.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.2.2",
    "react-hook-form": "^7.55.0",
    "react-phone-number-input": "^3.4.17",
    "react-router-dom": "7.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "latest",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
